.tab-shell {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  z-index: 900;
  height: 136rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 18rpx 48rpx rgba(99, 62, 29, 0.11);
  box-sizing: border-box;
}

.tab-shell.on-home {
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  background: rgba(255, 255, 255, 0.38);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.18);
}

.tab-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B8B8B8;
  gap: 2rpx;
}

.tab-item.active {
  background: transparent;
  color: #E89F71;
}

.tab-item.center {
  width: 112rpx;
  height: 112rpx;
  margin-top: -24rpx;
  border-radius: 50%;
  background: #EFD9CB;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.12);
}

.tab-item.center.active {
  background: #E8CDBD;
}

.tab-icon {
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.tab-item.center .tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.5;
}

.tab-item.center.active .tab-icon-img {
  opacity: 1;
}

.tab-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 800;
}

.tab-item:not(.active) .tab-label {
  opacity: 0;
}

.tab-dot {
  position: absolute;
  bottom: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E89F71;
}

.tab-item.center .tab-dot {
  display: none;
}
