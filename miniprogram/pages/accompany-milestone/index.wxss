.milestone-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.page-header {
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 36rpx)) 32rpx 0;
  min-height: calc(var(--nav-height, 64rpx) + var(--nav-top, calc(env(safe-area-inset-top) + 36rpx)));
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 80rpx 1fr 80rpx;
  align-items: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

.header-title {
  color: var(--on-primary-container);
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
  height: 80rpx;
}

.milestone-scroll {
  flex: 1;
  height: 0;
}

.days-card {
  margin: 48rpx 32rpx;
  padding: 56rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, var(--primary-strong) 0%, #FF6B3D 100%);
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 61, 0.3);
}

.days-label {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

.days-number {
  display: block;
  color: #FFFFFF;
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1.1;
}

.days-unit {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 32rpx;
}

.calendar-section {
  margin: 0 32rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.calendar-title {
  display: block;
  margin-bottom: 24rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-weekday {
  padding: 8rpx 0;
  margin-bottom: 8rpx;
  text-align: center;
}

.weekday-text {
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  font-weight: 600;
}

.calendar-cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-cell.empty {
  background: transparent;
}

.calendar-cell.today {
  border: 2rpx solid var(--primary-strong);
  background: rgba(255, 157, 118, 0.1);
}

.calendar-cell.accompanied {
  background: rgba(255, 157, 118, 0.08);
}

.cell-text {
  color: rgba(93, 64, 55, 0.6);
  font-size: 24rpx;
  font-weight: 600;
}

.cell-paw-img {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.72;
}

.message-section {
  margin: 48rpx 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 157, 118, 0.1);
  border-radius: 24rpx;
  background: rgba(255, 157, 118, 0.05);
}

.message-text {
  color: rgba(93, 64, 55, 0.5);
  font-size: 26rpx;
  line-height: 1.8;
  text-align: center;
}
