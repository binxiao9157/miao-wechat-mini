.history-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: var(--nav-top, calc(env(safe-area-inset-top) + 20rpx));
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.header-title {
  flex: 1;
  margin-right: 48rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.history-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 120rpx;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
}

.history-card,
.add-card {
  position: relative;
  aspect-ratio: 3 / 4;
  border-radius: 40rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid rgba(93, 64, 55, 0.08);
}

.history-card:active,
.add-card:active {
  transform: scale(0.95);
}

.thumb {
  width: 100%;
  height: 100%;
  background: var(--surface-container);
}

.thumb-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent 60%);
}

.play-mark {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 128rpx;
  height: 128rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.history-card:active .play-mark {
  opacity: 1;
}

.play-icon {
  width: 64rpx;
  height: 64rpx;
}

.delete-button {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.delete-icon {
  width: 24rpx;
  height: 24rpx;
}

.content {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
}

.name {
  display: block;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta,
.video-count {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.add-card {
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  color: rgba(93, 64, 55, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: none;
}

.add-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.empty {
  padding-top: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 192rpx;
  height: 192rpx;
  margin-bottom: 48rpx;
  border-radius: 80rpx;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon-img {
  width: 96rpx;
  height: 96rpx;
}

.empty-title {
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 800;
}

.empty-subtitle {
  max-width: 400rpx;
  margin-top: 12rpx;
  color: var(--text-hint);
  font-size: 26rpx;
  text-align: center;
}

.add-action {
  margin: 48rpx 32rpx 0;
}

