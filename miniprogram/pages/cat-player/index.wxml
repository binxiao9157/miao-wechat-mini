<view class="player-page">
  <view class="header">
    <image class="back-icon" src="/assets/profile-icons/arrowleft-white.png" mode="aspectFit" bindtap="goBack" />
    <text class="header-title">{{cat.name || '猫咪播放'}}</text>
  </view>

  <view class="player">
    <image wx:if="{{cat.avatar}}" class="player-bg" src="{{cat.avatar}}" mode="aspectFill" />
    <video
      wx:if="{{videoUrl && !error}}"
      class="video"
      src="{{videoUrl}}"
      autoplay
      loop
      muted
      controls="{{false}}"
      show-play-btn="{{false}}"
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      object-fit="contain"
      bindloadedmetadata="onVideoReady"
      bindplay="onVideoReady"
      binderror="onVideoError"
    ></video>
    <view wx:elif="{{error}}" class="error-panel">
      <text class="error-title">视频加载失败</text>
      <text class="error-desc">{{error}}</text>
      <button class="error-btn" bindtap="retryVideo">重试</button>
    </view>
    <view wx:else class="no-video">
      <text>暂无视频</text>
    </view>
    <view wx:if="{{loading && videoUrl && !error}}" class="loading-ring"></view>
  </view>

  <view class="action-chips">
    <button
      wx:for="{{actions}}"
      wx:key="key"
      class="chip {{item.active ? 'active' : ''}} {{item.generated ? '' : 'missing'}}"
      data-action="{{item.key}}"
      bindtap="selectAction"
    >{{item.label}}</button>
  </view>

  <view class="info-panel">
    <view class="meta-row">
      <text class="breed">{{cat.breed || 'AI 猫咪'}}</text>
      <text wx:if="{{createdDate}}" class="date">生成于 {{createdDate}}</text>
    </view>
    <text class="desc">这是您的专属 AI 猫咪，它会一直陪伴在您身边。</text>

    <view class="side-actions">
      <button class="round-action {{liked ? 'liked' : ''}}" bindtap="toggleLike">
        <view class="action-circle">
          <image class="action-icon" src="{{liked ? '/assets/profile-icons/heart-red.png' : '/assets/profile-icons/heart-gray.png'}}" mode="aspectFit" />
        </view>
        <text>{{liked ? '已喜欢' : '喜欢'}}</text>
      </button>
      <button class="round-action" bindtap="shareHint">
        <view class="action-circle">
          <image class="action-icon" src="/assets/profile-icons/share-gray.png" mode="aspectFit" />
        </view>
        <text>分享</text>
      </button>
    </view>

    <view class="footer-actions">
      <button class="footer-btn save" bindtap="saveVideo">
        <image class="footer-icon" src="/assets/profile-icons/download-primary.png" mode="aspectFit" />
        <text>保存到相册</text>
      </button>
      <button class="footer-btn delete" bindtap="deleteCat">
        <image class="footer-icon" src="/assets/profile-icons/trash2-red2.png" mode="aspectFit" />
        <text>删除记录</text>
      </button>
    </view>
  </view>
</view>
