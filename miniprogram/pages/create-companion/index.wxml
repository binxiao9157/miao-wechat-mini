<view class="create-companion-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">创建猫咪</text>
  </view>

  <scroll-view class="create-companion-scroll" scroll-y>
    <view class="form-section">
      <text class="form-label">CAT NAME</text>
      <input class="name-input" value="{{name}}" placeholder="例如：奶茶" bindinput="onNameInput" />
    </view>

    <view class="form-section">
      <text class="form-label">BREED PRESET</text>
      <view class="breed-grid">
      <view
        wx:for="{{presets}}"
        wx:key="id"
        class="breed-card {{selectedPresetId === item.id ? 'selected' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPreset"
      >
        <view wx:if="{{selectedPresetId === item.id}}" class="check-badge"><text class="check-mark">✓</text></view>
        <view class="breed-image-wrapper"><image class="breed-image" src="{{item.imageUrl}}" mode="aspectFill" /></view>
        <text class="breed-name {{selectedPresetId === item.id ? 'selected' : ''}}">{{item.name}}</text>
      </view>
      </view>
    </view>

    <view class="form-section">
      <text class="form-label">FUR COLOR</text>
      <input class="name-input" value="{{color}}" placeholder="例如：橘白、银渐层、奶牛色" bindinput="onColorInput" />
    </view>

    <text wx:if="{{error}}" class="error">{{error}}</text>
    <text wx:if="{{isRedemption}}" class="redemption">{{redemptionText}}</text>
  </scroll-view>

  <view class="bottom-bar">
    <button class="generate-btn active" loading="{{saving}}" bindtap="handleCreate">
      生成猫咪
    </button>
  </view>
</view>
