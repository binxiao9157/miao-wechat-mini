.diary-page {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 36rpx) 44rpx calc(210rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 84%, var(--color-warm-cream) 100%);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 34rpx;
}

.back {
  width: 84rpx;
  height: 84rpx;
  border-radius: 30rpx;
  background: #fff;
  color: var(--on-primary-container);
  font-size: 58rpx;
  line-height: 76rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.08);
}

.header-title {
  flex: 1;
  margin-left: 20rpx;
  color: var(--on-primary-container);
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
}

.friend-entry {
  min-width: 96rpx;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: #fff;
  color: var(--on-primary-container);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 84rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.08);
}

.composer {
  padding: 30rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 12rpx 34rpx rgba(99, 62, 29, 0.08);
}

.textarea {
  width: 100%;
  min-height: 210rpx;
  padding: 28rpx 30rpx;
  border-radius: 30rpx;
  background: var(--color-warm-cream);
  box-sizing: border-box;
  color: var(--on-primary-container);
  font-size: 30rpx;
  line-height: 1.6;
}

.media-preview {
  position: relative;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-warm-cream);
}

.preview-image,
.preview-video {
  width: 100%;
  height: 340rpx;
  display: block;
}

.clear-media {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  min-width: 96rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 27rpx;
  background: rgba(99, 62, 29, 0.74);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 54rpx;
}

.composer-actions {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.media-button {
  height: 68rpx;
  border-radius: 34rpx;
  background: var(--color-warm-cream);
  color: var(--on-primary-container);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 68rpx;
}

.submit {
  margin-top: 22rpx;
}

.tabs {
  display: flex;
  margin-top: 28rpx;
  padding: 12rpx;
  border-radius: 44rpx;
  background: var(--color-warm-cream);
}

.tab {
  flex: 1;
  height: 74rpx;
  border-radius: 34rpx;
  background: transparent;
  color: var(--on-surface-variant);
  font-size: 26rpx;
  font-weight: 900;
  line-height: 74rpx;
}

.tab.active {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(232, 159, 113, 0.18);
}

.list {
  height: calc(100vh - 760rpx);
  margin-top: 28rpx;
}

.diary-item {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-xl);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}

.diary-item.focused {
  box-shadow: 0 0 0 4rpx rgba(232, 159, 113, 0.3), 0 12rpx 34rpx rgba(99, 62, 29, 0.08);
}

.author-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--surface-container);
}

.author-info {
  flex: 1;
}

.author-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.author {
  display: block;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 600;
}

.time,
.cat-name {
  color: var(--text-hint);
  font-size: 22rpx;
  font-weight: 400;
}

.friend-badge {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  background: rgba(217, 155, 122, 0.1);
  color: var(--color-warm-brown-light);
  font-size: 20rpx;
  font-weight: 500;
}

.sync-badge {
  min-width: 88rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  background: #fff1f1;
  color: #d64b4b;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.sync-badge,
.sync-panel {
  display: none;
}

.content {
  display: block;
  margin-top: 0;
  margin-bottom: 20rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
}

.diary-media {
  width: 100%;
  max-height: 520rpx;
  margin: 0 0 20rpx;
  border-radius: var(--radius-lg);
  background: var(--color-warm-cream);
  overflow: hidden;
}

.media-fallback {
  margin-top: 18rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: var(--color-warm-cream);
  color: #b58d73;
  font-size: 25rpx;
  line-height: 160rpx;
  text-align: center;
}

.sync-panel {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #fff7f1;
  border: 2rpx solid #f4ded0;
}

.sync-message {
  display: block;
  color: #8a4b26;
  font-size: 23rpx;
  line-height: 1.5;
}

.sync-actions,
.engage-row {
  margin-top: 16rpx;
  display: flex;
  gap: 40rpx;
}

.engage {
  width: auto;
  height: 48rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--on-surface-variant);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 48rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sync-action.primary {
  background: var(--primary);
  color: #fff;
}

.engage.liked {
  background: transparent;
  color: var(--color-danger);
}

.engage-icon {
  width: 48rpx;
  height: 48rpx;
}

.delete-btn {
  margin-left: auto;
  opacity: 0.6;
}

.delete-icon {
  width: 36rpx;
  height: 36rpx;
}

.comments {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--color-warm-cream);
}

.comment {
  min-height: 48rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
}

.comment-author {
  flex-shrink: 0;
  color: var(--color-warm-brown);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.comment-text {
  flex: 1;
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.comment-delete {
  width: 70rpx;
  height: 42rpx;
  padding: 0;
  background: transparent;
  color: #b58d73;
  font-size: 22rpx;
  line-height: 42rpx;
}

.meta-row {
  display: none;
  margin-top: 20rpx;
  align-items: center;
  justify-content: space-between;
}

.delete {
  min-width: 86rpx;
  height: 50rpx;
  padding: 0 16rpx;
  border-radius: 25rpx;
  background: #fff1f1;
  color: #d64b4b;
  font-size: 22rpx;
  line-height: 50rpx;
}

.empty {
  padding: 120rpx 28rpx 0;
  color: var(--on-surface-variant);
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.comment-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
}

.comment-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.24);
}

.comment-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding: 20rpx;
  border-radius: 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 78rpx;
  padding: 0 24rpx;
  border-radius: 39rpx;
  background: var(--color-warm-cream);
  color: var(--on-primary-container);
  font-size: 27rpx;
}

.comment-send {
  width: 120rpx;
  height: 78rpx;
  padding: 0;
  border-radius: 39rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.share-card-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 600px;
  height: 820px;
  pointer-events: none;
}

/* Native alignment with the original mini-program diary page */
.diary-page {
  padding: 0;
}

.diary-list {
  height: 100vh;
  padding: 0 44rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  align-items: flex-end;
  padding: calc(var(--nav-top) + 96rpx) 0 34rpx;
}

.header-title {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 0;
}

.title-main {
  display: block;
  color: var(--on-primary-container);
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
}

.title-sub {
  display: block;
  margin-top: 16rpx;
  color: var(--on-surface-variant);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.friend-btn,
.add-btn {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}

.friend-btn {
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.08);
}

.add-btn {
  background: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(232, 159, 113, 0.2);
}

.friend-btn .icon-img,
.add-btn .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.tab-bar {
  display: flex;
  margin: 0 0 28rpx;
  padding: 12rpx;
  border-radius: 44rpx;
  background: var(--color-warm-cream);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border-radius: 34rpx;
}

.tab-item.active {
  background: var(--primary);
  box-shadow: 0 8rpx 20rpx rgba(232, 159, 113, 0.18);
}

.tab-text {
  color: var(--on-surface-variant);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 900;
}

.tab-indicator {
  display: none;
}

.tab-content {
  animation: tabFadeIn 0.25s ease-out;
}

.tab-slide-right {
  animation: slideInRight 0.25s ease-out;
}

.tab-slide-left {
  animation: slideInLeft 0.25s ease-out;
}

@keyframes tabFadeIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.empty {
  padding: 120rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-text {
  color: var(--on-surface-variant);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.4;
}

.empty-hint {
  margin-top: 16rpx;
  color: var(--on-surface-variant);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.6;
}

.compose-modal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: var(--color-overlay);
}

.compose-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 74vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: 48rpx 48rpx 0 0;
  background: #fff;
  box-shadow: 0 -18rpx 50rpx rgba(99, 62, 29, 0.12);
}

.keyboard-open .compose-content {
  max-height: 58vh;
}

.compose-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 42rpx 44rpx 24rpx;
}

.compose-title-wrap {
  flex: 1;
}

.compose-title {
  display: block;
  color: var(--on-primary-container);
  font-size: 40rpx;
  font-weight: 700;
}

.compose-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--on-surface-variant);
  font-size: 22rpx;
  font-weight: 600;
}

.close-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: var(--surface-container-low);
}

.close-btn .icon-img {
  width: 40rpx;
  height: 40rpx;
}

.compose-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 44rpx 32rpx;
}

.compose-input {
  width: 100%;
  min-height: 240rpx;
  padding: 34rpx 38rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 36rpx;
  background: var(--color-warm-cream);
  color: var(--on-primary-container);
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #8e8e8e;
}

.compose-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 28rpx 44rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-top: 2rpx solid var(--outline-variant);
  background: #fff;
}

.media-actions {
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
}

.media-btn {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--color-warm-cream);
}

.media-btn .icon-img {
  display: block;
}

.media-image-icon {
  width: 48rpx;
  height: 48rpx;
  transform: translateY(1rpx);
}

.media-video-icon {
  width: 54rpx;
  height: 54rpx;
  transform: translateY(1rpx);
}

.publish-btn {
  flex: 0 0 172rpx;
  width: 172rpx;
  min-width: 172rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.publish-btn::after,
.engage::after,
.comment-send::after,
.delete::after,
.sync-action::after,
.comment-delete::after {
  border: 0;
}

.publish-btn.loading {
  opacity: 0.8;
}

.publish-btn.disabled {
  opacity: 0.4;
}

.compose-modal .media-preview {
  width: 240rpx;
  height: 240rpx;
  margin: 0 0 32rpx;
  border-radius: 32rpx;
  background: #000;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.compose-modal .preview-image,
.compose-modal .preview-video {
  width: 100%;
  height: 100%;
}

.remove-media-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--color-overlay);
}

.remove-media-btn .icon-img {
  width: 32rpx;
  height: 32rpx;
}

.comment-modal {
  z-index: 1300;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.comment-modal-mask {
  position: absolute;
  inset: 0;
  background: var(--color-overlay);
}

.comment-modal-content {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  padding: 32rpx 40rpx calc(env(safe-area-inset-bottom) + 32rpx);
  border-radius: 48rpx 48rpx 0 0;
  background: #fff;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 8rpx 8rpx 32rpx;
  border-radius: 48rpx;
  background: var(--surface-container);
}

.comment-send-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff9a5a 0%, #ff6b3d 100%);
}

.comment-send-btn.disabled {
  opacity: 0.4;
}

.comment-send-btn .icon-img {
  width: 44rpx;
  height: 44rpx;
}

.comment-count {
  display: block;
  margin-top: 12rpx;
  padding-right: 104rpx;
  color: #bbb;
  font-size: 22rpx;
  text-align: right;
}

.add-friend-modal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.add-friend-mask {
  position: absolute;
  inset: 0;
  background: var(--color-overlay);
}

.add-friend-content {
  position: relative;
  z-index: 1;
  min-height: 44vh;
  max-height: 78vh;
  overflow-y: auto;
  padding: 56rpx 44rpx calc(env(safe-area-inset-bottom) + 96rpx);
  border-radius: 48rpx 48rpx 0 0;
  background: #fff;
  box-shadow: 0 -18rpx 50rpx rgba(99, 62, 29, 0.12);
  box-sizing: border-box;
}

.add-friend-header {
  margin-bottom: 44rpx;
  text-align: center;
}

.add-friend-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--on-primary-container);
  font-size: 36rpx;
  font-weight: 700;
}

.add-friend-subtitle {
  display: block;
  color: var(--on-surface-variant);
  font-size: 22rpx;
  font-weight: 600;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.cat-empty {
  grid-column: span 3;
  padding: 80rpx 0;
  color: var(--on-surface-variant);
  font-size: 28rpx;
  text-align: center;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 16rpx;
  border-radius: 28rpx;
  background: var(--surface-container-low);
}

.cat-item.selected {
  background: #fdf2e9;
  box-shadow: 0 0 0 3rpx var(--primary);
}

.cat-avatar {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.add-method-grid {
  display: flex;
  justify-content: center;
  margin-bottom: 48rpx;
}

.add-method-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx;
}

.add-method-icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.add-method-icon.qr-icon {
  background: var(--primary);
}

.method-icon-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.add-method-text {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.add-friend-back {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 32rpx;
  background: var(--surface-container);
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.comment-tooltip-overlay {
  position: fixed;
  inset: 0;
  z-index: 1400;
}

.comment-tooltip,
.single-page-banner,
.single-page-text {
  display: none;
}

.comment-tooltip-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.18);
}

.comment-tooltip {
  display: block;
  position: relative;
  min-width: 220rpx;
  border-radius: 22rpx;
  background: rgba(51, 42, 36, 0.96);
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.18);
}

.comment-tooltip-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
}

.comment-tooltip-btn {
  min-width: 110rpx;
  padding: 0 28rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.comment-tooltip-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.18);
}

.comment-tooltip-arrow {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  margin-left: -12rpx;
  background: rgba(51, 42, 36, 0.96);
  transform: rotate(45deg);
}

.danger {
  color: #f87171;
}
