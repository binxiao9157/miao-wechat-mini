.welcome-page {
  min-height: 100vh;
  padding: 0 48rpx 48rpx;
  background: var(--background);
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.back-btn {
  position: absolute;
  left: 36rpx;
  top: var(--nav-top, calc(env(safe-area-inset-top) + 36rpx));
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.back-btn:active {
  transform: scale(0.9);
}

.logo-section {
  margin-top: calc(var(--nav-top, calc(env(safe-area-inset-top) + 76rpx)) + 80rpx);
  margin-bottom: 64rpx;
  display: flex;
  align-items: center;
}

.logo-icon {
  width: 88rpx;
  height: 88rpx;
  transform: rotate(-12deg);
}

.logo-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  margin-left: -16rpx;
  color: var(--primary);
  font-size: 48rpx;
  font-weight: 900;
  background: linear-gradient(135deg, var(--color-warm-brown) 0%, var(--primary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.main-title {
  margin-bottom: 16rpx;
  color: var(--text-primary);
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1.2;
}

.main-desc {
  margin-bottom: 80rpx;
  color: var(--color-warm-brown-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.redemption {
  align-self: flex-start;
  margin-bottom: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-container);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 900;
}

.option-cards {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.option-card {
  position: relative;
  padding: 48rpx;
  border-radius: 48rpx;
  background: var(--color-warm-cream-dark);
}

.option-card:active {
  transform: scale(0.98);
}

.card-header {
  margin-bottom: 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(232, 159, 113, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
}

.paw-icon {
  opacity: 0.92;
}

.card-arrow {
  color: rgba(93, 64, 55, 0.2);
  font-size: 40rpx;
  font-weight: 300;
}

.card-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 900;
}

.card-desc {
  display: block;
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.upload-hint {
  width: 100%;
  height: 160rpx;
  margin-top: 36rpx;
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 40rpx;
  background: rgba(255, 249, 245, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-hint-text {
  color: rgba(93, 64, 55, 0.3);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.footer {
  padding-top: 80rpx;
  padding-bottom: 24rpx;
  text-align: center;
}

.footer-text {
  color: rgba(93, 64, 55, 0.25);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}
