<view class="generation-page">
  <view wx:if="{{phase === 'generating'}}" class="generating-view">
    <view class="loading-spinner">
      <view class="spinner-ring"></view>
      <view class="spinner-icon">
        <image class="icon-img spinner-img" src="/assets/profile-icons/sparkles-gray.png" mode="aspectFit" />
      </view>
    </view>
    <text class="status-subtitle">AWAKENING DIGITAL LIFE</text>
    <text class="status-title">{{statusText}}</text>
    <view class="progress-bar-wrapper">
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{progress}}%;"></view>
      </view>
    </view>
    <text class="progress-hint">{{currentIndex}} / {{totalCount}} · {{actionLabel}}</text>
    <view class="steps-list">
      <view class="step-item {{progress >= 5 ? 'active' : ''}} {{progress > 30 ? 'done' : ''}}">
        <view class="step-dot {{progress > 30 ? 'done' : (progress >= 5 ? 'active' : '')}}">
          <text class="step-num">{{progress > 30 ? '✓' : '1'}}</text>
        </view>
        <text class="step-label">构筑灵魂基石</text>
      </view>
      <view class="step-item {{progress >= 30 ? 'active' : ''}} {{progress >= 90 ? 'done' : ''}}">
        <view class="step-dot {{progress >= 90 ? 'done' : (progress >= 30 ? 'active' : '')}}">
          <text class="step-num">{{progress >= 90 ? '✓' : '2'}}</text>
        </view>
        <text class="step-label">注入生命律动</text>
      </view>
      <view class="step-item {{progress >= 100 ? 'active done' : ''}}">
        <view class="step-dot {{progress >= 100 ? 'done' : ''}}">
          <text class="step-num">{{progress >= 100 ? '✓' : '3'}}</text>
        </view>
        <text class="step-label">魔法连接完成</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{phase === 'success'}}" class="success-view">
    <image class="success-icon" src="/assets/profile-icons/checkcircle-green.png" mode="aspectFit" />
    <text class="success-title">{{statusText || '生成完成'}}</text>
    <text class="success-desc">你的数字猫咪已经准备好了</text>
    <button class="success-btn" bindtap="goHome">查看我的猫咪</button>
  </view>

  <view wx:elif="{{phase === 'confirm'}}" class="confirm-view">
    <video class="confirm-video" src="{{videoUrl}}" autoplay loop muted controls="{{false}}" object-fit="contain"></video>
    <view wx:if="{{showConfirmDialog}}" class="confirm-dialog">
      <view class="dialog-icon">
        <image class="dialog-icon-img" src="/assets/profile-icons/sparkles-primary.png" mode="aspectFit" />
      </view>
      <text class="dialog-title">我是你的梦中情猫吗？</text>
      <text class="dialog-desc">形象已初步锁定，是否继续解锁摸头、踩奶、逗猫这些更多动作？</text>
      <button class="dialog-button primary" loading="{{isUnlocking}}" bindtap="unlockAllActions">是，全部解锁</button>
      <button class="dialog-button secondary" bindtap="keepBasic">否，就这样吧</button>
    </view>
  </view>

  <view wx:else class="error-view">
    <image class="error-icon" src="/assets/profile-icons/alertcircle-red2.png" mode="aspectFit" />
    <text class="error-title">生成遇到问题</text>
    <text class="error-desc">{{error}}</text>
    <view class="error-actions">
      <button class="error-btn retry" bindtap="retry">重新尝试</button>
      <button class="error-btn back" bindtap="backToEdit">返回创建页</button>
      <button class="error-btn back" bindtap="goHome">稍后再说</button>
    </view>
  </view>
</view>
