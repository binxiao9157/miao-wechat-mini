<view class="home-page">
  <view wx:if="{{cat}}" class="topbar">
    <button class="tool-button" bindtap="goSwitch">切换</button>
    <button class="tool-button" bindtap="goHistory">历史</button>
    <button class="tool-button" bindtap="goProfile">我的</button>
  </view>

  <view
    wx:if="{{cat}}"
    class="video-fullscreen"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  >
    <video
      wx:if="{{currentVideo && !videoError}}"
      id="catVideo-{{videoRetryKey}}"
      class="cat-video"
      src="{{currentVideo}}"
      poster="{{poster}}"
      autoplay
      loop
      muted
      controls="{{false}}"
      show-loading="{{false}}"
      show-play-btn="{{false}}"
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      object-fit="cover"
      bindloadedmetadata="handleVideoLoaded"
      bindplay="handleVideoLoaded"
      binderror="handleVideoError"
    ></video>
    <image wx:if="{{poster && (!currentVideo || videoError)}}" class="placeholder-img" src="{{poster}}" mode="aspectFill" />
    <view wx:if="{{videoError}}" class="video-error-overlay">
      <text class="video-error-title">视频暂时无法播放</text>
      <text class="video-error-desc">{{videoErrorDesc}}</text>
      <button class="retry-btn" bindtap="retryVideo"><text class="retry-btn-text">重试播放</text></button>
    </view>
    <view class="bubble frosted-glass-bubble bubble-enter" wx:if="{{bubbleText}}">
      <view class="bubble-glow"></view>
      <view class="bubble-body"><text class="bubble-text">{{bubbleText}}</text></view>
      <view class="bubble-border-overlay"></view>
    </view>
    <view class="points-toast" wx:if="{{pointsToast}}"><text class="points-toast-text">{{pointsToast}}</text></view>
  </view>

  <view wx:if="{{cat}}" class="action-bar">
    <button wx:for="{{actionItems}}" wx:key="key" class="action-chip {{item.active ? 'active' : ''}} {{item.generated ? '' : 'missing'}}" data-action="{{item.key}}" bindtap="selectAction">{{item.label}}</button>
    <button wx:if="{{canContinueGeneration}}" class="action-chip unlock" bindtap="continueGeneration">补齐</button>
  </view>

  <view wx:if="{{!cat}}" class="no-cat-screen">
    <text class="no-cat-text">还没有猫咪</text>
    <button class="add-cat-btn" bindtap="createCat"><text class="add-cat-btn-text">领养一只</text></button>
  </view>

  <native-tab-bar active="home" />
</view>
