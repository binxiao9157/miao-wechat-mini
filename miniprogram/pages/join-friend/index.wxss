.join-friend-page {
  min-height: 100vh;
  padding: 0 48rpx 48rpx;
  background: var(--background);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.page-header {
  width: 100%;
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 20rpx)) 0 24rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
}

.error-state,
.content {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.error-icon-box {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-emoji {
  color: var(--primary-strong);
  font-size: 64rpx;
  font-weight: 900;
}

.error-title,
.inviter-name {
  margin-bottom: 12rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 900;
}

.error-desc,
.inviter-desc {
  color: rgba(93, 64, 55, 0.5);
  font-size: 26rpx;
  text-align: center;
}

.manual-form {
  width: 100%;
  margin-top: 64rpx;
}

.manual-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 48rpx;
  background: var(--color-warm-cream);
  color: var(--on-primary-container);
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.inviter-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.inviter-avatar {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 40rpx;
  background: var(--primary-strong);
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.2);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inviter-avatar-img {
  width: 140rpx;
  height: 140rpx;
}

.inviter-avatar-text {
  color: #fff;
  font-size: 56rpx;
  font-weight: 900;
}

.inviter-cat-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.inviter-cat-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--color-warm-cream);
  display: flex;
  align-items: center;
  justify-content: center;
}

.inviter-cat-emoji {
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 900;
}

.inviter-cat {
  color: rgba(93, 64, 55, 0.5);
  font-size: 26rpx;
}

.action-section {
  width: 100%;
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.action-btn.primary {
  background: var(--primary-strong);
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.2);
}

.action-btn.secondary {
  margin-top: 20rpx;
  background: #fff;
  border: 1rpx solid rgba(93, 64, 55, 0.1);
}

.action-btn-text {
  color: var(--color-warm-brown);
  font-size: 30rpx;
  font-weight: 800;
}

.action-btn-text.white {
  color: #fff;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

.success-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  background: rgba(255, 249, 245, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.success-icon-box {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 24rpx;
  border-radius: 70rpx;
  background: rgba(82, 196, 26, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-emoji {
  color: var(--color-success);
  font-size: 64rpx;
  font-weight: 900;
}

.success-title {
  margin-bottom: 8rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 900;
}

.success-desc {
  color: rgba(93, 64, 55, 0.5);
  font-size: 26rpx;
}

.success-back-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-full);
  background: var(--primary);
}

.success-back-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.login-hint {
  color: var(--on-surface-variant);
  font-size: 24rpx;
  line-height: 1.6;
}
