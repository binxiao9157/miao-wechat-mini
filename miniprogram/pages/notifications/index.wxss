.notifications-page {
  min-height: 100vh;
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 56rpx)) 32rpx 56rpx;
  background: var(--background);
}

.header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 80rpx;
}

.back-icon {
  position: absolute;
  left: 0;
  width: 48rpx;
  height: 48rpx;
}

.header-title {
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 700;
}

.hero {
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-icon {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 20rpx;
  border-radius: 40rpx;
  background: rgba(232, 159, 113, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.hero-title {
  margin-bottom: 8rpx;
  color: var(--color-warm-brown);
  font-size: 40rpx;
  font-weight: 900;
}

.hero-subtitle {
  color: rgba(93, 64, 55, 0.3);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.settings-card {
  padding: 0 36rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.62);
}

.setting-item {
  min-height: 144rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: rgba(232, 159, 113, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.setting-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-title {
  display: block;
  color: var(--color-warm-brown);
  font-size: 30rpx;
  font-weight: 700;
}

.setting-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--text-hint);
  font-size: 24rpx;
  line-height: 1.4;
}

.footer-note {
  margin-top: 48rpx;
  padding: 0 8rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.settings-hero,
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-icon-wrap,
.setting-icon-box,
.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon-text {
  color: var(--primary-strong);
  font-size: 32rpx;
  font-weight: 900;
}

.setting-item-border {
  border-bottom: 1rpx solid rgba(93, 64, 55, 0.06);
}

.setting-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.settings-footer,
.footer-text {
  color: rgba(93, 64, 55, 0.4);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}
