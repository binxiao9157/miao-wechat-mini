.profile-page {
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 82%, var(--color-warm-cream) 100%);
  display: flex;
  flex-direction: column;
}

.profile-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.profile-content {
  padding: 0 42rpx calc(220rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(var(--nav-top) + 96rpx) var(--nav-side, 42rpx) 34rpx var(--nav-side, 42rpx);
  background: transparent;
  column-gap: 24rpx;
}

.header-title {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header-title .title {
  max-width: 260rpx;
  color: var(--on-primary-container);
  font-size: 60rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-title .subtitle {
  margin-top: 16rpx;
  color: var(--on-surface-variant);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

.header-btn {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(93, 64, 55, 0.1);
}

.header-icon {
  width: 48rpx;
  height: 48rpx;
}

.unread-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 8rpx;
  border: 4rpx solid #fff;
  border-radius: 20rpx;
  background: #ff5252;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unread-text {
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}

.profile-header {
  padding: 16rpx 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  margin-bottom: 24rpx;
}

.avatar {
  width: 224rpx;
  height: 224rpx;
  border: 6rpx solid #fff;
  border-radius: 50%;
  background: var(--surface-container);
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  font-weight: 900;
}

.image-avatar {
  background: var(--surface-container);
}

.avatar-edit-btn {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: var(--primary-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-edit-icon {
  width: 32rpx;
  height: 32rpx;
}

.nickname {
  max-width: 400rpx;
  margin-bottom: 4rpx;
  color: var(--on-primary-container);
  font-size: 40rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.username {
  max-width: 640rpx;
  margin-bottom: 32rpx;
  color: var(--text-hint);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-row {
  width: 100%;
  display: flex;
  gap: 32rpx;
  margin: 64rpx 0 32rpx;
}

.stat-card {
  flex: 1;
  padding: 32rpx;
  border-bottom: 6rpx solid rgba(255, 157, 118, 0.2);
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(93, 64, 55, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 8rpx;
  opacity: 0.4;
}

.stat-value {
  color: var(--primary);
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--color-warm-brown-muted);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.cat-entry {
  width: 100%;
  margin-top: 32rpx;
  padding: 32rpx;
  border-left: 6rpx solid var(--primary);
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(93, 64, 55, 0.08);
  display: flex;
  align-items: center;
}

.cat-entry-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 157, 118, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cat-entry-icon image {
  width: 40rpx;
  height: 40rpx;
}

.cat-entry-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cat-entry-label {
  color: var(--on-primary-container);
  font-size: 28rpx;
  font-weight: 700;
}

.cat-entry-value {
  margin-top: 4rpx;
  color: var(--color-warm-brown-muted);
  font-size: 22rpx;
}

.cat-entry-arrow {
  color: rgba(93, 64, 55, 0.3);
  font-size: 46rpx;
  line-height: 1;
}

.menu-section {
  width: 100%;
  margin-top: 48rpx;
  background: transparent;
}

.menu-title {
  display: block;
  margin-left: 16rpx;
  margin-bottom: 24rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.menu-item {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  margin: 0 0 22rpx;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(93, 64, 55, 0.06);
  align-items: center;
  text-align: left;
  line-height: 1.2;
}

.menu-item.danger {
  background: #fff5f5;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 32rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon image {
  width: 36rpx;
  height: 36rpx;
}

.bg-blue-50 {
  background: #eff6ff;
}

.bg-orange-50 {
  background: #fff7ed;
}

.bg-purple-50 {
  background: #f5f3ff;
}

.bg-gray-50 {
  background: #f9fafb;
}

.bg-red-50 {
  background: #fef2f2;
}

.menu-label {
  flex: 1;
  min-width: 0;
  color: var(--on-primary-container);
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.danger-text {
  color: var(--color-danger);
}

.menu-arrow {
  color: rgba(93, 64, 55, 0.3);
  font-size: 32rpx;
  line-height: 1;
}

.menu-arrow.danger,
.danger {
  color: #fca5a5;
}

.footer {
  margin-top: 96rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-text {
  color: rgba(93, 64, 55, 0.3);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.footer-hearts {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
}

.footer-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.heart-primary {
  background: var(--primary-strong);
}

.heart-secondary {
  background: var(--color-warm-brown-light);
}

.footer-icp {
  margin-top: 12rpx;
  color: rgba(93, 64, 55, 0.2);
  font-size: 20rpx;
}
