.set-nickname-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 78%, var(--surface-container-low) 100%);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.bg-decoration {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(232, 159, 113, 0.05);
}

.bg-decoration-1 {
  width: 256rpx;
  height: 256rpx;
  top: -80rpx;
  right: -80rpx;
}

.bg-decoration-2 {
  width: 256rpx;
  height: 256rpx;
  left: -80rpx;
  bottom: -80rpx;
}

.page-header {
  width: 100%;
  padding: var(--nav-top) 24rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  position: relative;
  z-index: 10;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 40rpx;
  height: 40rpx;
}

.content {
  width: 100%;
  padding: 48rpx 48rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 10;
}

.title-section {
  margin-bottom: 64rpx;
  text-align: center;
}

.title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--on-primary-container);
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  color: var(--on-surface-variant);
  font-size: 26rpx;
  font-weight: 500;
}

.input-section {
  width: 100%;
  position: relative;
  margin-bottom: 64rpx;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  padding: 0 100rpx 0 32rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 48rpx;
  background: var(--color-warm-cream);
  box-sizing: border-box;
  font-size: 32rpx;
  color: var(--on-primary-container);
}

.char-count {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--on-surface-variant);
  font-size: 24rpx;
}

.buttons {
  width: 100%;
}

button.save-btn,
button.skip-btn {
  width: 100%;
  height: 96rpx;
  margin: 0 0 24rpx;
  padding: 0;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
}

button.save-btn {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

button.skip-btn {
  border: 2rpx solid var(--outline-variant);
  background: #fff;
  color: var(--on-primary-container);
}

button.save-btn::after,
button.skip-btn::after {
  border: 0;
}

button.save-btn.disabled,
button.save-btn[disabled] {
  opacity: 0.6;
}
