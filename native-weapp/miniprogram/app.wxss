page {
  min-height: 100%;
  --primary: #E89F71;
  --primary-strong: #FF9D76;
  --primary-container: #FDF2E9;
  --on-primary-container: #633E1D;
  --background: #FFF9F5;
  --surface: #FFFFFF;
  --surface-container: #FEF6F0;
  --surface-container-low: #FFFBF8;
  --on-surface: #633E1D;
  --on-surface-variant: #8E8E8E;
  --outline: #E5D5C8;
  --outline-variant: #F2E6DD;
  --soft-shadow: 0 12rpx 34rpx rgba(99, 62, 29, 0.08);
  --text-primary: #1C1B1F;
  --text-secondary: #79747E;
  --text-hint: rgba(93, 64, 55, 0.5);
  --text-link: #E89F71;
  --color-danger: #FF4D4F;
  --color-success: #4CAF50;
  --color-warning: #FF9800;
  --color-warm-brown: #5D4037;
  --color-warm-brown-light: #D99B7A;
  --color-warm-brown-muted: rgba(93, 64, 55, 0.6);
  --color-warm-cream: #FEF6F0;
  --color-warm-cream-dark: #F5F0EB;
  --color-overlay: rgba(0, 0, 0, 0.5);
  --color-overlay-dark: rgba(0, 0, 0, 0.85);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 999rpx;
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 12rpx 34rpx rgba(99, 62, 29, 0.08);
  --shadow-lg: 0 18rpx 48rpx rgba(99, 62, 29, 0.11);
  --nav-top: calc(env(safe-area-inset-top) + var(--wechat-capsule-safe-top-gap) + 16rpx);
  --nav-height: 64rpx;
  --nav-side: 42rpx;
  --wechat-capsule-safe-right: 184rpx;
  --wechat-capsule-safe-top-gap: 76rpx;
  background: var(--background);
  color: var(--on-primary-container);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

view,
text,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

.miao-page {
  min-height: 100vh;
  background: var(--background);
}

.miao-tab-safe {
  padding-bottom: calc(166rpx + env(safe-area-inset-bottom));
}

.miao-button-primary {
  min-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-strong) 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 157, 118, 0.26);
}

.miao-button-secondary {
  min-height: 96rpx;
  border-radius: 48rpx;
  background: var(--surface-container);
  color: var(--on-primary-container);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.miao-button-primary::after,
.miao-button-secondary::after {
  border: 0;
}

.icon-img {
  display: block;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: var(--nav-top, calc(env(safe-area-inset-top) + 20rpx));
  min-height: calc(var(--nav-height) + var(--wechat-capsule-safe-top-gap));
}

.page-header .header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-warm-brown);
}

.miao-page-shell {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 82%, var(--color-warm-cream) 100%);
  color: var(--on-surface);
}
