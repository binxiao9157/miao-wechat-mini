<view class="tab-shell">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{item.key === 'home' ? 'center' : ''}} {{item.active ? 'active' : ''}}"
    data-url="{{item.url}}"
    data-key="{{item.key}}"
    bindtap="go"
  >
    <text class="tab-icon">{{item.icon}}</text>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
