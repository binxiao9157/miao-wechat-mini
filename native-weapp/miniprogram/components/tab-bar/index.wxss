.tab-shell {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 50;
  height: 104rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(99, 62, 29, 0.08);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 6rpx;
  box-shadow: 0 18rpx 44rpx rgba(99, 62, 29, 0.14);
}

.tab-item {
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8E8E8E;
}

.tab-item.active {
  background: #FEF6F0;
  color: #E89F71;
}

.tab-icon {
  height: 32rpx;
  font-size: 30rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.tab-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 26rpx;
  font-weight: 800;
}
