.tab-shell {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  z-index: 900;
  height: 136rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 18rpx 48rpx rgba(99, 62, 29, 0.11);
}

.tab-item {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B8B8B8;
  gap: 2rpx;
}

.tab-item.active {
  background: transparent;
  color: #E89F71;
}

.tab-item.center {
  width: 112rpx;
  height: 112rpx;
  margin-top: -24rpx;
  background: #E8CDBD;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.12);
}

.tab-icon {
  height: 40rpx;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.tab-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.1;
  font-weight: 800;
}

.tab-item:not(.active) .tab-label {
  opacity: 0;
}
