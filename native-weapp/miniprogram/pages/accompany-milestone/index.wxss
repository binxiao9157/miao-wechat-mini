.milestone-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.hero {
  margin-top: 38rpx;
  padding: 38rpx;
  border-radius: 28rpx;
  background: #633E1D;
}

.cat-name,
.subtitle {
  color: rgba(255, 255, 255, 0.76);
  font-size: 27rpx;
}

.days {
  display: block;
  margin-top: 14rpx;
  color: #FFFFFF;
  font-size: 72rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
}

.stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat {
  min-height: 140rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.value {
  color: #633E1D;
  font-size: 40rpx;
  font-weight: 900;
}

.label {
  margin-top: 8rpx;
  color: #8E8E8E;
  font-size: 24rpx;
}

.list {
  margin-top: 32rpx;
}

.item {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.item.done {
  border: 2rpx solid #E89F71;
}

.mark {
  color: #E89F71;
  font-size: 34rpx;
  font-weight: 900;
}

.text {
  color: #633E1D;
  font-size: 28rpx;
  font-weight: 800;
}
