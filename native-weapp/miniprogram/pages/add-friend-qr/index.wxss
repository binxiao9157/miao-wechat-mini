.invite-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.invite-card {
  margin-top: 60rpx;
  padding: 42rpx 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
}

.label {
  color: #8E8E8E;
  font-size: 26rpx;
}

.code {
  display: block;
  margin-top: 24rpx;
  color: #633E1D;
  font-size: 50rpx;
  font-weight: 900;
  word-break: break-all;
}

.qr-box {
  width: 360rpx;
  min-height: 420rpx;
  margin: 28rpx auto 0;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx #F0E5DC;
}

.qr-image,
.qr-canvas {
  width: 320rpx;
  height: 320rpx;
  background: #FFFFFF;
}

.qr-note {
  display: block;
  margin-top: 16rpx;
  color: #6E5844;
  font-size: 22rpx;
  line-height: 1.45;
}

.desc {
  display: block;
  margin-top: 26rpx;
  color: #6E5844;
  font-size: 27rpx;
  line-height: 1.6;
}

.action {
  margin-top: 28rpx;
}
