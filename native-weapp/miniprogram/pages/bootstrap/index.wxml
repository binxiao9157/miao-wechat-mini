<view class="bootstrap-page">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="hero">
    <image class="logo" src="../../assets/logo.png" mode="aspectFit" />
    <text class="title">Miao Native</text>
    <text class="subtitle">原生微信小程序迁移分支已启动</text>
  </view>

  <view class="panel">
    <view class="row">
      <text class="label">后端</text>
      <text class="value">{{apiBaseUrl}}</text>
    </view>
    <view class="row">
      <text class="label">登录态</text>
      <text class="value">{{authLabel}}</text>
    </view>
    <view class="row">
      <text class="label">同步</text>
      <text class="value">{{syncLabel}}</text>
    </view>
  </view>

  <button class="miao-button-primary action" bindtap="handleCheckHealth" loading="{{checking}}">
    检查服务
  </button>
  <button class="miao-button-secondary action" bindtap="handleSync" loading="{{syncing}}">
    同步基础数据
  </button>
</view>
