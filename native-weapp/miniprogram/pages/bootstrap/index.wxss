.bootstrap-page {
  min-height: 100vh;
  padding: 0 48rpx 56rpx;
  background: #FFF9F5;
}

.hero {
  padding-top: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 28rpx;
}

.title {
  color: #633E1D;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
}

.subtitle {
  margin-top: 18rpx;
  color: #8E8E8E;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel {
  margin-top: 64rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 44rpx rgba(99, 62, 29, 0.08);
}

.row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.row + .row {
  border-top: 1rpx solid #F2E6DD;
}

.label {
  flex: none;
  color: #8E8E8E;
  font-size: 26rpx;
}

.value {
  flex: 1;
  color: #633E1D;
  font-size: 24rpx;
  text-align: right;
  word-break: break-all;
}

.action {
  margin-top: 32rpx;
}
