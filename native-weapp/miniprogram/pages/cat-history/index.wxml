<view class="history-page">
  <view class="header">
    <image class="back-icon" src="/assets/profile-icons/arrowleft-dark.png" mode="aspectFit" bindtap="goBack" />
    <text class="header-title">猫咪历史</text>
  </view>

  <scroll-view class="history-scroll" scroll-y>
    <view wx:if="{{cats.length}}" class="history-grid">
      <view
        wx:for="{{cats}}"
        wx:key="id"
        class="history-card"
        data-id="{{item.id}}"
        bindtap="openCat"
      >
        <image class="thumb" src="{{item.avatar}}" mode="aspectFill" />
        <view class="thumb-overlay"></view>
        <view class="play-mark"><image class="play-icon" src="/assets/profile-icons/play-white.png" mode="aspectFit" /></view>
        <button
          class="delete-button"
          catchtap="deleteCat"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
        ><image class="delete-icon" src="/assets/profile-icons/trash2-red2.png" mode="aspectFit" /></button>
        <view class="content">
          <text class="name">{{item.name || '小猫'}}</text>
          <text class="meta">{{item.createdDate || '未知日期'}}</text>
          <text class="video-count">{{item.videoCount}} 个视频 · {{item.generationStatus || 'draft'}}</text>
        </view>
      </view>
      <view class="add-card" bindtap="addCat">
        <view class="add-icon"><image class="add-icon-img" src="/assets/profile-icons/plus-white.png" mode="aspectFit" /></view>
        <text>生成新猫咪</text>
      </view>
    </view>

    <view wx:else class="empty">
      <view class="empty-icon"><image class="empty-icon-img" src="/assets/profile-icons/sparkles-gray.png" mode="aspectFit" /></view>
      <text class="empty-title">还没有生成记录</text>
      <text class="empty-subtitle">上传照片后，猫咪会出现在这里。</text>
    </view>

    <button wx:if="{{!cats.length}}" class="miao-button-primary add-action" bindtap="addCat">生成新猫咪</button>
  </scroll-view>
</view>
