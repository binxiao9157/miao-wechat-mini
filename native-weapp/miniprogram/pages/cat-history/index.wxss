.history-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.history-scroll {
  height: calc(100vh - 150rpx);
  margin-top: 32rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.history-item {
  min-height: 152rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 18rpx;
  background: #FEF6F0;
}

.content {
  flex: 1;
  min-width: 0;
}

.name {
  display: block;
  color: #633E1D;
  font-size: 31rpx;
  font-weight: 900;
}

.meta {
  display: block;
  margin-top: 10rpx;
  color: #8E8E8E;
  font-size: 23rpx;
}

.delete-button {
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #FFF1F1;
  color: #D64B4B;
  font-size: 24rpx;
  line-height: 56rpx;
}

.empty {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-subtitle {
  margin-top: 16rpx;
  color: #8E8E8E;
  font-size: 26rpx;
}

.add-action {
  margin-top: 32rpx;
}
