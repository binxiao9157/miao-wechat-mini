ding-indicator,.pause-indicator{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%)}.pause-btn-circle{width:112rpx;height:112rpx;border-radius:50%;background:rgba(255,255,255,.18)}.player-footer{position:absolute;left:0;right:0;bottom:0;padding:40rpx 44rpx calc(env(safe-area-inset-bottom) + 40rpx);color:#fff}.footer-info{margin-bottom:32rpx}.footer-tags{display:flex;gap:12rpx}.breed-tag{padding:8rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.16)}.breed-tag-text,.footer-date,.footer-desc,.action-label{color:rgba(255,255,255,.75);font-size:24rpx}.footer-actions-side{position:absolute;right:32rpx;bottom:220rpx;display:flex;flex-direction:column;gap:24rpx}.action-item{display:flex;flex-direction:column;align-items:center;gap:8rpx}.icon-img{width:48rpx;height:48rpx}
