.player-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background: #000000;
  color: #FFFFFF;
}

.header {
  position: absolute;
  top: var(--nav-top, calc(env(safe-area-inset-top) + 20rpx));
  left: 24rpx;
  right: 24rpx;
  z-index: 40;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.35);
}

.player {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.3;
  filter: blur(20px);
}

.video {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.no-video,
.error-panel {
  position: relative;
  z-index: 2;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.error-title {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
}

.error-desc,
.no-video {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  line-height: 1.6;
}

.error-btn {
  width: 220rpx;
  height: 80rpx;
  margin-top: 32rpx;
  border-radius: 40rpx;
  background: var(--primary-strong);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
}

.loading-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  margin-top: -40rpx;
  margin-left: -40rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.action-chips {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(env(safe-area-inset-bottom) + 178rpx);
  z-index: 35;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.chip {
  height: 68rpx;
  padding: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}

.chip.active {
  background: var(--primary);
}

.chip.missing {
  color: rgba(255, 255, 255, 0.42);
}

.info-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  padding: 48rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  background: linear-gradient(to top, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.42), transparent);
}

.meta-row {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.breed {
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  background: var(--primary-strong);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.date {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  font-weight: 700;
}

.desc {
  display: block;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  line-height: 1.5;
}

.side-actions {
  position: absolute;
  right: 32rpx;
  bottom: 240rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.round-action {
  padding: 0;
  background: transparent;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.round-action::after,
.footer-btn::after,
.chip::after {
  border: 0;
}

.action-circle {
  width: 80rpx;
  height: 80rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.round-action.liked .action-circle {
  background: rgba(255, 77, 79, 0.22);
}

.footer-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 24rpx;
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.footer-btn.save {
  background: #FFFFFF;
  color: #000000;
}

.footer-btn.delete {
  border: 1rpx solid rgba(255, 77, 79, 0.3);
  background: rgba(255, 77, 79, 0.2);
  color: var(--color-danger);
}

.footer-icon {
  width: 36rpx;
  height: 36rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
