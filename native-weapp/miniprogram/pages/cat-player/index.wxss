.player-page {
  min-height: 100vh;
  padding: 56rpx 36rpx 48rpx;
  background: #111111;
  color: #FFFFFF;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #FFFFFF;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  flex: 1;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 900;
}

.player {
  position: relative;
  margin-top: 30rpx;
  height: 880rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: #000000;
}

.player-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.2;
  filter: blur(18rpx);
}

.video {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.no-video,
.error-panel {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.84);
  font-size: 28rpx;
  text-align: center;
}

.error-title {
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 900;
}

.error-desc {
  max-width: 470rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.5;
}

.error-btn {
  margin-top: 28rpx;
  width: 160rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #E89F71;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.loading-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 3;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
  margin-top: -28rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.32);
  border-top-color: #FFFFFF;
  animation: spin 0.8s linear infinite;
}

.action-chips {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.chip {
  height: 68rpx;
  padding: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.chip.active {
  background: #E89F71;
}

.chip.missing {
  color: rgba(255, 255, 255, 0.42);
}

.info-panel {
  margin-top: 26rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.1);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.breed {
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(232, 159, 113, 0.22);
  color: #FFD6BA;
  font-size: 23rpx;
  font-weight: 900;
}

.date {
  color: rgba(255, 255, 255, 0.56);
  font-size: 23rpx;
}

.desc {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
  line-height: 1.55;
}

.side-actions,
.footer-actions {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.round-action,
.footer-btn {
  height: 70rpx;
  padding: 0;
  border-radius: 35rpx;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 70rpx;
}

.round-action {
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
}

.round-action.liked {
  background: rgba(214, 75, 75, 0.28);
  color: #FFCCCC;
}

.footer-btn.save {
  background: #FFFFFF;
  color: #633E1D;
}

.footer-btn.delete {
  background: rgba(214, 75, 75, 0.24);
  color: #FFCCCC;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
