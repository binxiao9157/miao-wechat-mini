.cat-start-page {
  min-height: 100vh;
  background: var(--background);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.back-btn {
  position: absolute;
  left: 36rpx;
  top: var(--nav-top, calc(env(safe-area-inset-top) + 36rpx));
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.back-btn:active {
  transform: scale(0.9);
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

.bg-decoration {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bg-decoration-1 {
  width: 512rpx;
  height: 512rpx;
  top: -120rpx;
  right: -120rpx;
  background: rgba(232, 159, 113, 0.05);
  animation: pulse 4s ease-in-out infinite;
}

.bg-decoration-2 {
  width: 512rpx;
  height: 512rpx;
  bottom: -120rpx;
  left: -120rpx;
  background: rgba(232, 159, 113, 0.05);
  animation: pulse 4s ease-in-out infinite 2s;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 80rpx;
  position: relative;
  z-index: 10;
}

.illustration {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 64rpx;
  position: relative;
}

.illustration-bg {
  position: absolute;
  inset: 0;
  border-radius: 96rpx;
  background: #FFFFFF;
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.paw-layer {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
}

.paw-back {
  opacity: 0.1;
  transform: rotate(12deg);
}

.paw-front {
  opacity: 0.2;
  transform: rotate(-12deg);
  animation: float 4s ease-in-out infinite;
}

.sparkle {
  position: absolute;
  font-size: 40rpx;
  animation: sparkle-pulse 3s ease-in-out infinite;
}

.sparkle-1 {
  top: 48rpx;
  right: 48rpx;
}

.sparkle-2 {
  bottom: 64rpx;
  left: 48rpx;
  animation-delay: 1.5s;
}

.main-title {
  margin-bottom: 24rpx;
  color: var(--on-primary-container);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.3;
}

.main-desc {
  margin-bottom: 96rpx;
  color: var(--color-warm-brown-muted);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.start-btn {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 24rpx 48rpx rgba(232, 159, 113, 0.3);
  position: relative;
  overflow: hidden;
}

.start-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.start-btn-text,
.start-btn-arrow {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 900;
}

.start-btn-arrow {
  animation: arrow-move 1.5s ease-in-out infinite;
}

.footer {
  position: absolute;
  right: 0;
  bottom: 60rpx;
  left: 0;
  text-align: center;
}

.footer-text {
  color: rgba(93, 64, 55, 0.25);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
}

@keyframes float {
  0%,
  100% {
    transform: rotate(-12deg) translateY(0);
  }
  50% {
    transform: rotate(-8deg) translateY(-16rpx);
  }
}

@keyframes sparkle-pulse {
  0%,
  100% {
    opacity: 0.3;
    transform: scale(1);
  }
  50% {
    opacity: 0.7;
    transform: scale(1.2);
  }
}

@keyframes arrow-move {
  0%,
  100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(8rpx);
  }
}
