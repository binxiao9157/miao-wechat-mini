.cat-start-page {
  min-height: 100vh;
  padding: 56rpx 36rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #FFF9F5;
  display: flex;
  flex-direction: column;
}

.header {
  height: 72rpx;
}

.back {
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.logo {
  width: 220rpx;
  height: 220rpx;
  border-radius: 110rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
}

.title {
  margin-top: 42rpx;
  color: #633E1D;
  font-size: 44rpx;
  font-weight: 900;
}

.desc {
  margin-top: 20rpx;
  max-width: 560rpx;
  color: #6E5844;
  font-size: 28rpx;
  line-height: 1.7;
}

.start {
  width: 100%;
  margin-top: 52rpx;
}

.footer {
  color: #B58D73;
  font-size: 21rpx;
  text-align: center;
}
.back-btn{width:96rpx;height:96rpx;display:flex;align-items:center;justify-content:center;border-radius:32rpx;background:#fff}.bg-decoration,.bg-decoration-1,.bg-decoration-2{position:absolute;border-radius:50%;background:rgba(232,159,113,.08)}.illustration{position:relative;display:flex;align-items:center;justify-content:center}.illustration-bg{position:absolute;inset:0;border-radius:50%;background:var(--color-warm-cream)}.paw-layer,.paw-back,.paw-front{position:absolute}.sparkle,.sparkle-1,.sparkle-2{position:absolute;width:16rpx;height:16rpx;border-radius:50%;background:var(--primary)}.main-title{color:var(--text-primary);font-size:48rpx;font-weight:900}.main-desc{color:var(--on-surface-variant);font-size:28rpx;line-height:1.7}.start-btn{height:104rpx;display:flex;align-items:center;justify-content:center;gap:16rpx;border-radius:999rpx;background:var(--primary)}.start-btn-text{color:#fff;font-size:32rpx;font-weight:900}.start-btn-arrow{color:#fff}.footer-text{color:rgba(93,64,55,.35);font-size:22rpx}.icon-img{width:48rpx;height:48rpx}
