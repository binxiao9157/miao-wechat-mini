.change-password-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.page-header {
  min-height: 120rpx;
  padding: var(--nav-top) 48rpx 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  color: var(--color-warm-brown);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
}

.page-title {
  margin-left: 20rpx;
  color: var(--color-warm-brown);
  font-size: 34rpx;
  font-weight: 900;
}

.change-password-scroll {
  flex: 1;
  height: 0;
  padding: 0 48rpx 48rpx;
  box-sizing: border-box;
}

.intro-section {
  margin-bottom: 64rpx;
}

.intro-icon-box {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
  border-radius: 48rpx;
  background: rgba(255, 157, 118, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
}

.icon-img.large {
  width: 64rpx;
  height: 64rpx;
}

.intro-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-warm-brown);
  font-size: 40rpx;
  font-weight: 900;
}

.intro-desc {
  display: block;
  color: var(--color-warm-brown-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.form-section {
  margin-bottom: 48rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  margin-left: 8rpx;
  margin-bottom: 12rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.input-icon {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 96rpx;
  padding-right: 72rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
}

.input-toggle {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

button.save-btn {
  width: 100%;
  height: 100rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 50rpx;
  background: var(--primary-strong);
  box-shadow: 0 16rpx 48rpx rgba(255, 157, 118, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

button.save-btn::after {
  border: 0;
}

.save-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
}

.footer-hint {
  display: block;
  margin-top: 80rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-align: center;
}
.toast{position:fixed;left:50%;bottom:180rpx;z-index:1500;transform:translateX(-50%);padding:18rpx 30rpx;border-radius:999rpx;background:rgba(0,0,0,.72)}.toast-text{color:#fff;font-size:24rpx;font-weight:900}.error-box{padding:18rpx 24rpx;border-radius:20rpx;background:#fff1f1}.error-text{color:var(--color-danger);font-size:24rpx}
