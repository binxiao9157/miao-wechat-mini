<view class="create-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">创建猫咪</text>
  </view>

  <view class="hero">
    <image class="avatar" src="{{selectedPresetImage || '/assets/logo.png'}}" mode="aspectFill" />
    <text class="title">创建猫咪</text>
    <text wx:if="{{isRedemption}}" class="redemption">{{redemptionText}}</text>
  </view>

  <view class="form">
    <text class="label">名字</text>
    <input class="input" value="{{name}}" placeholder="例如：奶茶" bindinput="onNameInput" />

    <text class="label">品种预设</text>
    <scroll-view class="preset-scroll" scroll-x>
      <view
        wx:for="{{presets}}"
        wx:key="id"
        class="preset-card {{selectedPresetId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPreset"
      >
        <image class="preset-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <text class="preset-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <text class="label">毛色</text>
    <input class="input" value="{{color}}" placeholder="例如：橘白、银渐层、奶牛色" bindinput="onColorInput" />

    <text wx:if="{{error}}" class="error">{{error}}</text>

    <button class="miao-button-primary action" loading="{{saving}}" bindtap="handleCreate">
      生成猫咪
    </button>
  </view>
</view>
