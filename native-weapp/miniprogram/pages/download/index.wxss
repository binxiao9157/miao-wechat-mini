.download-page {
  min-height: 100vh;
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 56rpx)) 40rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--background) 0%, #FFFFFF 100%);
}

.header {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.back-icon {
  position: absolute;
  left: 0;
  width: 48rpx;
  height: 48rpx;
}

.header-title {
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 700;
}

.qr-section {
  margin-top: 52rpx;
  padding: 44rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  text-align: center;
  box-shadow: var(--shadow-md);
}

.qr-frame {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 32rpx;
  border-radius: 32rpx;
  background: var(--background);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.qr-code {
  width: 280rpx;
  height: 280rpx;
}

.hint {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.subhint {
  display: block;
  margin-top: 10rpx;
  color: var(--on-surface-variant);
  font-size: 24rpx;
  line-height: 1.45;
}

.features {
  margin-top: 32rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.feature-item {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(99, 62, 29, 0.05);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--surface-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.feature-text {
  flex: 1;
  min-width: 0;
}

.feature-title {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.feature-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--on-surface-variant);
  font-size: 24rpx;
}

.download-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.download-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.download-icon {
  width: 32rpx;
  height: 32rpx;
}

.content {
  padding: 0 40rpx;
}

.android {
  background: var(--surface-container);
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}
