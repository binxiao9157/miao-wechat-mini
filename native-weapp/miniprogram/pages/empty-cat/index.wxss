.welcome-page {
  min-height: 100vh;
  padding: 0 48rpx 48rpx;
  background: var(--background);
  display: flex;
  flex-direction: column;
}

.logo-section {
  margin-top: calc(var(--nav-top, calc(env(safe-area-inset-top) + 76rpx)) + 80rpx);
  margin-bottom: 64rpx;
  display: flex;
  align-items: center;
}

.logo-icon {
  width: 110rpx;
  height: 110rpx;
  transform: rotate(-12deg);
}

.logo-text {
  margin-left: -10rpx;
  color: var(--color-warm-brown);
  font-size: 48rpx;
  font-weight: 900;
}

.main-title {
  margin-bottom: 16rpx;
  color: var(--text-primary);
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1.2;
}

.main-desc {
  margin-bottom: 48rpx;
  color: var(--color-warm-brown-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.redemption {
  align-self: flex-start;
  margin-bottom: 32rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-container);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 900;
}

.option-cards {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.option-card {
  position: relative;
  padding: 48rpx;
  border-radius: 48rpx;
  background: var(--color-warm-cream-dark);
}

.option-card:active {
  transform: scale(0.98);
}

.card-header {
  margin-bottom: 36rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(232, 159, 113, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
}

.card-arrow {
  color: rgba(93, 64, 55, 0.2);
  font-size: 48rpx;
  font-weight: 300;
}

.card-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 900;
}

.card-desc {
  display: block;
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.upload-hint {
  width: 100%;
  height: 160rpx;
  margin-top: 36rpx;
  border: 4rpx dashed rgba(93, 64, 55, 0.15);
  border-radius: 40rpx;
  background: rgba(255, 249, 245, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-hint-text {
  color: rgba(93, 64, 55, 0.3);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.footer {
  padding-top: 80rpx;
  padding-bottom: 24rpx;
  text-align: center;
}

.footer-text {
  color: rgba(93, 64, 55, 0.25);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}
