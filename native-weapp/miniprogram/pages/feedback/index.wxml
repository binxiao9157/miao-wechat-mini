<view class="feedback-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">意见反馈</text>
  </view>
  <view class="form">
    <textarea class="textarea" value="{{content}}" maxlength="800" placeholder="告诉我们哪里不好用，或者你想要什么功能" data-field="content" bindinput="onInput" />
    <input class="input" value="{{contact}}" placeholder="联系方式，可选" data-field="contact" bindinput="onInput" />
    <button class="miao-button-primary submit" loading="{{saving}}" bindtap="submit">提交反馈</button>
  </view>
</view>
