.feedback-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.feedback-page.success-page {
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.page-header {
  min-height: 120rpx;
  padding: calc(env(safe-area-inset-top) + 20rpx) 40rpx 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  color: var(--color-warm-brown);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
}

.page-title {
  margin-left: 20rpx;
  color: var(--color-warm-brown);
  font-size: 34rpx;
  font-weight: 900;
}

.feedback-scroll,
.content-scroll {
  flex: 1;
  height: 0;
  padding: 32rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.success-card {
  width: 100%;
  margin: 0 40rpx;
  padding: 80rpx 60rpx;
  border-radius: 48rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  border-radius: 60rpx;
  background: rgba(76, 175, 80, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}

.success-title {
  margin-bottom: 12rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 900;
}

.success-desc {
  color: var(--color-warm-brown-muted);
  font-size: 26rpx;
}

.survey-section,
.simple-section {
  padding-bottom: 48rpx;
}

.survey-notice {
  margin-bottom: 40rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(232, 159, 113, 0.15);
  border-radius: 24rpx;
  background: rgba(232, 159, 113, 0.08);
}

.notice-text {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.6;
}

.question-card,
.feedback-card {
  margin-bottom: 24rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.5);
}

.question-text {
  display: block;
  margin-bottom: 20rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.required-mark {
  color: #d84315;
}

.option-item {
  margin-bottom: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.option-item.selected {
  border-color: var(--primary);
  background: rgba(232, 159, 113, 0.05);
}

.radio-dot,
.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio-dot {
  border-radius: 18rpx;
}

.checkbox-box {
  border-radius: 8rpx;
}

.radio-dot.checked {
  border-color: var(--primary);
}

.checkbox-box.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--primary);
}

.checkbox-tick {
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
}

.option-label {
  color: var(--color-warm-brown);
  font-size: 26rpx;
}

.rating-row {
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: space-between;
}

.rating-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  width: 64rpx;
  height: 64rpx;
}

.rating-label {
  color: var(--text-hint);
  font-size: 20rpx;
  font-weight: 700;
}

.question-textarea,
.feedback-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 20rpx;
  background: #fff;
  box-sizing: border-box;
  color: var(--color-warm-brown);
  font-size: 26rpx;
}

.feedback-textarea {
  height: 300rpx;
}

.section-label {
  display: block;
  margin-bottom: 20rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.type-grid {
  margin-bottom: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-btn {
  padding: 16rpx 28rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
  background: #fff;
}

.type-btn.active {
  border-color: var(--primary);
  background: rgba(232, 159, 113, 0.05);
}

.type-btn-text {
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
  font-weight: 800;
}

.type-btn-text.active {
  color: var(--primary);
}

button.submit-btn {
  width: 100%;
  height: 96rpx;
  margin: 40rpx 0;
  padding: 0;
  border-radius: 48rpx;
  background: var(--primary-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

button.submit-btn::after {
  border: 0;
}

.submit-btn-text {
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.footer-text {
  display: block;
  color: var(--text-hint);
  font-size: 22rpx;
  text-align: center;
}
