.generation-page {
  min-height: 100vh;
  padding: 0 60rpx;
  background: var(--background);
  color: var(--color-warm-brown);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.generating-view {
  width: 100%;
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 80rpx;
}

.spinner-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border: 6rpx solid rgba(255, 157, 118, 0.1);
  border-top-color: var(--primary-strong);
  border-radius: 48rpx;
  animation: spin 4s linear infinite;
}

.spinner-icon {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: pulse 2s ease-in-out infinite;
}

.spinner-img {
  width: 96rpx;
  height: 96rpx;
}

.status-subtitle {
  margin-bottom: 12rpx;
  color: var(--primary-strong);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
}

.status-title {
  margin-bottom: 32rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.progress-bar-wrapper {
  width: 100%;
  margin-bottom: 24rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: rgba(255, 157, 118, 0.1);
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: var(--primary-strong);
  transition: width 0.5s ease;
}

.progress-hint {
  margin-bottom: 80rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.steps-list {
  width: 100%;
  margin-top: 40rpx;
}

.step-item {
  margin-bottom: 40rpx;
  opacity: 0.3;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-item.active,
.step-item.done {
  opacity: 1;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 157, 118, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-dot.active {
  background: var(--primary-strong);
}

.step-dot.done {
  background: var(--color-success);
}

.step-num {
  color: var(--primary-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.step-dot.active .step-num,
.step-dot.done .step-num {
  color: #FFFFFF;
}

.step-label {
  color: rgba(93, 64, 55, 0.4);
  font-size: 26rpx;
  font-weight: 600;
}

.step-item.active .step-label,
.step-item.done .step-label {
  color: var(--color-warm-brown);
}

.confirm-view {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-video {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #000000;
}

.confirm-dialog {
  position: relative;
  z-index: 2;
  width: 85%;
  max-width: 600rpx;
  padding: 60rpx 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dialog-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
  border-radius: 50%;
  background: rgba(255, 157, 118, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-icon-img {
  width: 72rpx;
  height: 72rpx;
}

.dialog-title {
  margin-bottom: 16rpx;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.dialog-desc {
  margin-bottom: 56rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.dialog-button {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.dialog-button.primary {
  background: var(--primary-strong);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.3);
}

.dialog-button.secondary {
  margin-top: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
}

.success-view,
.error-view {
  width: 100%;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.success-icon {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 32rpx;
}

.success-title,
.error-title {
  color: var(--color-warm-brown);
  font-size: 40rpx;
  font-weight: 800;
}

.success-desc,
.error-desc {
  margin-top: 16rpx;
  margin-bottom: 80rpx;
  color: var(--color-warm-brown-muted);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.success-btn {
  width: 400rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--primary-strong) 0%, #FF6B3D 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 107, 61, 0.3);
}

.error-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.error-actions {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.error-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.error-btn.retry {
  background: var(--primary-strong);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.2);
}

.error-btn.back {
  border: 1rpx solid rgba(93, 64, 55, 0.1);
  background: #FFFFFF;
  color: var(--color-warm-brown-muted);
  font-size: 26rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
