.generation-page {
  min-height: 100vh;
  padding: 80rpx 48rpx;
  background: #111111;
  color: #FFFFFF;
}

.center {
  min-height: calc(100vh - 160rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 12rpx solid rgba(255, 255, 255, 0.18);
  border-top-color: #E89F71;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: spin 1.2s linear infinite;
}

.percent {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 900;
  animation: spinReverse 1.2s linear infinite;
}

.title {
  margin-top: 48rpx;
  color: #FFFFFF;
  font-size: 42rpx;
  font-weight: 900;
  text-align: center;
}

.subtitle,
.error {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}

.preview-video {
  width: 100%;
  height: 760rpx;
  border-radius: 28rpx;
  background: #000000;
}

.action {
  width: 100%;
  margin-top: 32rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes spinReverse {
  from { transform: rotate(0deg); }
  to { transform: rotate(-360deg); }
}
