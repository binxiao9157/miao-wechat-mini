<view class="home-page">
  <text class="eyebrow">Miao Native</text>
  <text class="title">{{cat ? cat.name || 'Miao 首页' : 'Miao 首页'}}</text>
  <text class="subtitle">{{statusText}}</text>

  <view wx:if="{{cat}}" class="cat-card">
    <video
      wx:if="{{idleVideo}}"
      class="cat-video"
      src="{{idleVideo}}"
      autoplay
      loop
      muted
      controls="{{false}}"
      object-fit="contain"
    ></video>
    <image wx:else class="cat-avatar" src="{{cat.avatar}}" mode="aspectFill" />
    <view class="cat-info">
      <text class="cat-name">{{cat.name || '小猫'}}</text>
      <text class="cat-meta">{{cat.breed || '未知品种'}} · {{cat.generationStatus || 'draft'}}</text>
    </view>
  </view>

  <button wx:if="{{canContinueGeneration}}" class="miao-button-primary action" bindtap="continueGeneration">
    继续生成视频
  </button>
  <button class="miao-button-secondary action" bindtap="logout">退出登录</button>
</view>
