.home-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  overflow: hidden;
}

.topbar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 28rpx);
  right: 28rpx;
  z-index: 40;
  display: flex;
  gap: 12rpx;
}

.tool-button {
  min-width: 84rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.video-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.cat-video,
.placeholder-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.placeholder-img {
  z-index: 1;
}

.cat-video {
  z-index: 2;
}

.video-error-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-overlay);
  gap: 16rpx;
}

.video-error-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}

.video-error-desc {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

.retry-btn,
.add-cat-btn {
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  background: var(--primary-strong);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.bubble {
  position: absolute;
  left: 50%;
  top: 24%;
  transform: translateX(-50%);
  max-width: 460rpx;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.26);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  z-index: 32;
}

.points-toast {
  position: absolute;
  left: 50%;
  top: 40%;
  transform: translateX(-50%);
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(232, 159, 113, 0.9);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.18);
}

.action-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 184rpx);
  z-index: 42;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.action-chip {
  width: 112rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(99, 62, 29, 0.08);
}

.action-chip.active {
  background: rgba(232, 159, 113, 0.94);
  color: #FFFFFF;
}

.action-chip.missing {
  opacity: 0.48;
  border: 1rpx dashed rgba(255, 255, 255, 0.26);
}

.no-cat-screen {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.no-cat-text {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
}
.retry-btn-text,.add-cat-btn-text,.points-toast-text{font-size:28rpx;font-weight:900}
