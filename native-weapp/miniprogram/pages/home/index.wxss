.home-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  overflow: hidden;
}

.topbar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 28rpx);
  right: 28rpx;
  z-index: 40;
  display: flex;
  gap: 12rpx;
}

.tool-button {
  min-width: 84rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
}

.video-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.cat-video,
.placeholder-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.placeholder-img {
  z-index: 1;
}

.cat-video {
  z-index: 2;
}

.video-error-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-overlay);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  gap: 16rpx;
}

.video-error-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}

.video-error-desc {
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
}

.retry-btn,
.add-cat-btn {
  padding: 20rpx 64rpx;
  border-radius: 40rpx;
  background: var(--primary-strong);
  color: #FFFFFF;
}

.add-cat-btn {
  padding: 24rpx 80rpx;
  border-radius: 999rpx;
}

.bubble,
.frosted-glass-bubble {
  position: absolute;
  left: 32rpx;
  top: 22%;
  z-index: 40;
  pointer-events: none;
}

.bubble-glow {
  position: absolute;
  inset: 0;
  z-index: -1;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  filter: blur(40rpx);
  opacity: 0.5;
  transform: scale(1.5);
}

.bubble-body {
  position: relative;
  min-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.1);
}

.bubble-text {
  color: #4A2E1B;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
}

.bubble-border-overlay {
  position: absolute;
  inset: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  pointer-events: none;
}

.points-toast {
  position: absolute;
  left: 50%;
  top: 40%;
  transform: translateX(-50%);
  z-index: 50;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(232, 159, 113, 0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #FFFFFF;
  box-shadow: none;
  pointer-events: none;
}

.action-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 184rpx);
  z-index: 42;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.action-chip {
  width: 112rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(99, 62, 29, 0.08);
}

.action-chip.active {
  background: rgba(232, 159, 113, 0.94);
  color: #FFFFFF;
}

.action-chip.missing {
  opacity: 0.48;
  border: 1rpx dashed rgba(255, 255, 255, 0.26);
}

.no-cat-screen {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.no-cat-text {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.6);
}
.retry-btn-text,
.add-cat-btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.points-toast-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}
