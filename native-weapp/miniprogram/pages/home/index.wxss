.home-page {
  min-height: 100vh;
  padding: 72rpx 32rpx calc(166rpx + env(safe-area-inset-bottom));
  background: #FFF9F5;
}

.topbar {
  height: 72rpx;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.tool-button {
  min-width: 96rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 60rpx;
  box-shadow: 0 10rpx 24rpx rgba(99, 62, 29, 0.08);
}

.stage {
  position: relative;
  margin-top: 28rpx;
  height: min(970rpx, calc(100vh - 360rpx));
  min-height: 680rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #111111;
}

.cat-video,
.cat-avatar {
  width: 100%;
  height: 100%;
}

.cat-avatar {
  background: #FEF6F0;
}

.video-error {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.video-error-title {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
}

.retry-button {
  min-width: 140rpx;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: #E89F71;
  color: #FFFFFF;
  font-size: 25rpx;
  line-height: 60rpx;
}

.bubble {
  position: absolute;
  left: 44rpx;
  top: 54rpx;
  max-width: 460rpx;
  padding: 18rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #633E1D;
  font-size: 28rpx;
  font-weight: 800;
}

.points-toast {
  position: absolute;
  left: 50%;
  top: 140rpx;
  transform: translateX(-50%);
  padding: 16rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(232, 159, 113, 0.94);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.18);
}

.cat-info-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 120rpx 36rpx 36rpx;
  background: linear-gradient(180deg, rgba(17, 17, 17, 0), rgba(17, 17, 17, 0.72));
}

.title {
  display: block;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.5;
}

.action-bar {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.action-chip {
  height: 72rpx;
  padding: 0;
  border-radius: 36rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
  box-shadow: 0 10rpx 24rpx rgba(99, 62, 29, 0.08);
}

.action-chip.active {
  background: #E89F71;
  color: #FFFFFF;
}

.action-chip.missing {
  color: #B9A99B;
  border: 1rpx dashed #E1D4CA;
}

.action {
  margin-top: 28rpx;
}

.empty {
  min-height: 760rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
}

.empty .title {
  color: #633E1D;
  text-align: center;
}

.empty .subtitle {
  color: #8E8E8E;
  text-align: center;
}
