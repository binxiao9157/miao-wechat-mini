<view class="login-page">
  <view class="hero">
    <image class="logo" src="../../assets/logo.png" mode="aspectFit" />
    <text class="title">欢迎来到 Miao</text>
    <text class="subtitle">以喵星之名，守护你的每一份温暖</text>
  </view>

  <view class="form">
    <input class="input" value="{{username}}" placeholder="用户名" bindinput="onUsernameInput" />
    <view class="password-line">
      <input class="input password" value="{{password}}" placeholder="密码" password="{{!showPassword}}" bindinput="onPasswordInput" />
      <text class="toggle" bindtap="togglePassword">{{showPassword ? '隐藏' : '显示'}}</text>
    </view>

    <text wx:if="{{error}}" class="error">{{error}}</text>

    <view class="agreement" bindtap="toggleAgreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agreement-text">我已阅读并同意 </text>
      <text class="agreement-link" catchtap="goTerms">服务条款</text>
      <text class="agreement-text"> 和 </text>
      <text class="agreement-link" catchtap="goPrivacyPolicy">隐私政策</text>
    </view>

    <button class="miao-button-primary action" loading="{{loading}}" bindtap="handlePasswordLogin">
      登录
    </button>
    <button class="miao-button-secondary action" loading="{{loading}}" bindtap="handleWechatLogin">
      微信登录
    </button>
    <button class="phone-login action" loading="{{loading}}" open-type="getPhoneNumber" bindgetphonenumber="handlePhoneLogin">
      手机号快捷登录
    </button>
    <button class="link-button" bindtap="goRegister">创建新账号</button>
    <button class="link-button" bindtap="goResetPassword">忘记密码</button>
  </view>
</view>
