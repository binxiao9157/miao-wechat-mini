.login-page {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 78%, var(--surface-container-low) 100%);
  position: relative;
  overflow: hidden;
}

.bg-decoration {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(232, 159, 113, 0.05);
}

.bg-decoration-1 {
  width: 256rpx;
  height: 256rpx;
  top: -80rpx;
  right: -80rpx;
}

.bg-decoration-2 {
  width: 256rpx;
  height: 256rpx;
  left: -80rpx;
  bottom: -80rpx;
}

.content {
  width: 100%;
  height: 100vh;
  padding: calc(env(safe-area-inset-top) + 24rpx) 48rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 10;
}

.main-area {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding-top: 0;
}

.logo-section {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 8rpx;
}

.logo-wrapper {
  width: 66rpx;
  height: 66rpx;
  transform: rotate(-12deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  width: 66rpx;
  height: 66rpx;
}

.app-name {
  margin-left: -16rpx;
  background: linear-gradient(to right, var(--color-warm-brown) 0%, var(--primary) 100%);
  color: var(--color-warm-brown);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.05em;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.title-section {
  text-align: center;
}

.title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--on-primary-container);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subtitle {
  color: var(--on-surface-variant);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.cat-container {
  width: min(280rpx, 26vh);
  height: min(280rpx, 26vh);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cat-outer {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 96rpx;
  background: var(--color-warm-cream);
  box-shadow: 0 20rpx 60rpx rgba(99, 62, 29, 0.08);
}

.cat-inner {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  border: 24rpx solid var(--color-warm-cream);
  border-radius: 72rpx;
  background: var(--color-warm-cream);
  overflow: hidden;
}

.cat-image {
  width: 100%;
  height: 100%;
}

.form-section {
  width: 100%;
}

.input-group {
  margin-bottom: 20rpx;
}

.miao-input {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 48rpx;
  background: var(--color-warm-cream);
  box-sizing: border-box;
  color: #633e1d;
  font-size: 28rpx;
  font-weight: 400;
}

.password-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input {
  padding-right: 82rpx;
}

.eye-icon {
  position: absolute;
  right: 32rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
}

.forgot-password {
  margin-bottom: 8rpx;
  text-align: right;
}

.forgot-text {
  color: #e89f71;
  font-size: 24rpx;
  font-weight: 700;
}

.error-text {
  display: block;
  margin-bottom: 8rpx;
  color: #f44336;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 10rpx;
  margin-bottom: 16rpx;
  width: 100%;
}

.custom-checkbox {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  margin-top: 4rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 8rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.agreement-text {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  color: #8e8e8e;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 400;
}

.agreement-normal {
  color: #8e8e8e;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 400;
}

.link {
  margin: 0 4rpx;
  color: #e89f71;
  font-weight: 700;
  font-size: 24rpx;
  line-height: 1.5;
}

.buttons {
  width: 100%;
  min-width: 100%;
  padding-top: 4rpx;
}

button.login-btn,
button.phone-login-btn,
button.wechat-login-btn {
  width: 100%;
  min-width: 100%;
  height: 88rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  border-radius: 48rpx;
  border: 0;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

button.login-btn {
  background: var(--primary);
}

button.phone-login-btn,
button.wechat-login-btn {
  background: #07c160;
}

button.phone-login-btn {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.login-btn::after,
.phone-login-btn::after,
.wechat-login-btn::after,
.link-button::after {
  border: 0;
}

.register-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 20rpx;
}

.register-link-text {
  color: #8e8e8e;
  font-size: 26rpx;
  font-weight: 400;
}

.register-link-action {
  color: #e89f71;
  font-size: 26rpx;
  font-weight: 800;
}

.footer {
  flex-shrink: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 8rpx);
  text-align: center;
}

.footer-links {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.footer-link {
  color: rgba(102, 102, 102, 0.6);
  font-size: 22rpx;
  font-weight: 600;
}

.dot {
  color: rgba(102, 102, 102, 0.2);
}

.copyright {
  color: rgba(102, 102, 102, 0.4);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.shake{animation:shake .25s linear}
