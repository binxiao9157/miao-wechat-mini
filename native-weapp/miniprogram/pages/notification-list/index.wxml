<view class="message-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">消息中心</text>
  </view>
  <scroll-view class="list" scroll-y>
    <view wx:for="{{items}}" wx:key="id" class="item" data-target="{{item.target}}" bindtap="openItem">
      <text class="title">{{item.title}}</text>
      <text class="content">{{item.content}}</text>
    </view>
    <view wx:if="{{!items.length}}" class="empty">暂无消息</view>
  </scroll-view>
</view>
