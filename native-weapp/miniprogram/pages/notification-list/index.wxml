<view class="notification-list-page message-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">消息中心</text>
    <view class="settings-btn"><image class="icon-img" src="/assets/profile-icons/settings-dark.png" mode="aspectFit"></image></view>
  </view>

  <view wx:if="{{unreadCount > 0}}" class="action-bar">
    <text class="unread-count">{{unreadCount}} 条未读</text>
    <view class="mark-all-btn" bindtap="markAllRead"><text class="mark-all-text">全部已读</text></view>
  </view>

  <scroll-view class="notification-list-scroll list" scroll-y>
    <view wx:if="{{items.length}}" class="notification-list">
      <view wx:for="{{items}}" wx:key="id" class="notification-item item {{item.unread ? 'unread' : 'read'}}" data-id="{{item.id}}" data-source="{{item.source}}" data-target="{{item.target}}" bindtap="openItem">
        <view class="notification-icon icon {{item.type}}">
          <text>{{item.type === 'points' ? '分' : item.type === 'letter' ? '信' : item.type === 'greeting' ? '喵' : '讯'}}</text>
        </view>
        <view class="notification-content body">
          <view class="notification-header title-row">
            <text class="notification-title title">{{item.title}}</text>
            <view wx:if="{{item.unread}}" class="unread-dot dot"></view>
          </view>
          <text class="notification-desc content">{{item.content}}</text>
          <text class="notification-time time">{{item.timeLabel}}</text>
        </view>
        <text class="notification-arrow arrow">›</text>
      </view>
    </view>
    <view wx:else class="empty-state empty">
      <view class="empty-icon-box"><image class="icon-img" src="/assets/profile-icons/bell-gray.png" mode="aspectFit"></image></view>
      <text class="empty-title">暂无消息</text>
      <text class="empty-desc">新的提醒会出现在这里</text>
    </view>
  </scroll-view>
</view>
