.message-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.list {
  height: calc(100vh - 230rpx);
  margin-top: 32rpx;
}

.action-bar {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.06);
}

.unread-count {
  color: #633E1D;
  font-size: 26rpx;
  font-weight: 900;
}

.read-all {
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #FEF6F0;
  color: #633E1D;
  font-size: 24rpx;
  line-height: 56rpx;
}

.item {
  margin-bottom: 18rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.06);
}

.item.read {
  opacity: 0.72;
}

.icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #FEF6F0;
  color: #E89F71;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 60rpx;
  text-align: center;
}

.body {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  display: block;
  flex: 1;
  color: #633E1D;
  font-size: 30rpx;
  font-weight: 900;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #D64B4B;
}

.content {
  display: block;
  margin-top: 10rpx;
  color: #6E5844;
  font-size: 26rpx;
  line-height: 1.55;
}

.time {
  display: block;
  margin-top: 8rpx;
  color: #B58D73;
  font-size: 22rpx;
}

.arrow {
  color: #B58D73;
  font-size: 42rpx;
}

.empty {
  padding-top: 160rpx;
  color: #8E8E8E;
  text-align: center;
  font-size: 28rpx;
}

.notification-list-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 0;
  background: var(--background);
}

.notification-list-scroll {
  flex: 1;
  height: 0;
}

.settings-btn {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.mark-all-btn {
  padding: 8rpx 20rpx;
}

.mark-all-text {
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 700;
}

.notification-list {
  padding: 32rpx;
}

.notification-item {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
  padding: 40rpx;
  border-radius: 24rpx;
  background: #fff;
}

.unread {
  border-left: 4rpx solid var(--primary-strong);
}

.notification-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 32rpx;
}

.notification-icon.letter {
  background: rgba(255, 157, 118, 0.1);
  color: var(--primary-strong);
}

.notification-icon.points {
  background: rgba(255, 193, 7, 0.1);
  color: #ffc107;
}

.notification-icon.greeting {
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-danger);
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.notification-title {
  overflow: hidden;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--color-danger);
}

.notification-desc {
  display: block;
  overflow: hidden;
  margin-bottom: 4rpx;
  color: var(--text-hint);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-time {
  display: block;
  color: rgba(93, 64, 55, 0.3);
  font-size: 20rpx;
}

.notification-arrow {
  flex-shrink: 0;
  color: rgba(93, 64, 55, 0.2);
  font-size: 32rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-icon-box {
  width: 256rpx;
  height: 256rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  border-radius: 80rpx;
  background: var(--surface-container);
}

.empty-title {
  margin-bottom: 8rpx;
  color: var(--color-warm-brown);
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  color: rgba(93, 64, 55, 0.4);
  font-size: 24rpx;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}
