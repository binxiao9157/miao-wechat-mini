<view class="notifications-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">通知</text>
    <button class="read-button" bindtap="markAllRead">全读</button>
  </view>

  <scroll-view class="list" scroll-y>
    <view wx:for="{{notifications}}" wx:key="id" class="notification {{item.read ? 'read' : ''}}">
      <view class="dot" wx:if="{{!item.read}}"></view>
      <view class="content">
        <text class="title">{{item.title || '通知'}}</text>
        <text class="body">{{item.content}}</text>
        <text class="time">{{item.timeLabel}}</text>
      </view>
    </view>
    <view wx:if="{{!notifications.length}}" class="empty">暂无通知</view>
  </scroll-view>
</view>
