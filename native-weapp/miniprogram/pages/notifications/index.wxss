.notifications-page {
  min-height: 100vh;
  padding: 56rpx 36rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 28rpx;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.hero {
  margin-top: 40rpx;
  padding: 36rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
  text-align: center;
}

.hero-icon {
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto;
  border-radius: 41rpx;
  background: #FEF1E8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.hero-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #B58D73;
  font-size: 21rpx;
  letter-spacing: 0;
}

.settings-card {
  margin-top: 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 14rpx 30rpx rgba(99, 62, 29, 0.06);
}

.setting-item {
  min-height: 138rpx;
  padding: 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #F2E7DE;
}

.setting-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #FEF1E8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.setting-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.setting-info {
  flex: 1;
}

.setting-title {
  display: block;
  color: #633E1D;
  font-size: 28rpx;
  font-weight: 900;
}

.setting-desc {
  display: block;
  margin-top: 8rpx;
  color: #8E8E8E;
  font-size: 23rpx;
  line-height: 1.45;
}

.footer-note {
  margin-top: 26rpx;
  padding: 0 16rpx;
  color: #8E8E8E;
  font-size: 23rpx;
  line-height: 1.55;
}
