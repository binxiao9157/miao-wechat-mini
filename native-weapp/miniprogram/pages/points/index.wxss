.points-page {
  min-height: 100vh;
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 76rpx)) 44rpx calc(220rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 82%, var(--color-warm-cream) 100%);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.back {
  width: 72rpx;
  height: 72rpx;
  color: var(--color-warm-brown);
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
}

.header-title {
  flex: 1;
  color: var(--on-primary-container);
  font-size: 60rpx;
  line-height: 1;
  font-weight: 900;
}

.total-panel {
  position: relative;
  overflow: hidden;
  min-height: 318rpx;
  margin-bottom: 64rpx;
  padding: 64rpx;
  border-radius: 52rpx;
  background: #E0A171;
  color: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(99, 62, 29, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.total-panel::before,
.total-panel::after {
  content: '';
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(40rpx);
}

.total-panel::before {
  top: -40rpx;
  right: -40rpx;
}

.total-panel::after {
  bottom: -40rpx;
  left: -40rpx;
}

.total-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.total-value {
  color: #FFFFFF;
  font-size: 112rpx;
  line-height: 1;
  font-weight: 900;
}

.total-note {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: var(--on-primary-container);
  font-size: 36rpx;
  font-weight: 700;
}

.section-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(232, 159, 113, 0.1);
  color: var(--primary);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.task-item {
  margin-bottom: 24rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.06);
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.task-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: rgba(232, 159, 113, 0.05);
  color: var(--primary);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.task-item.completed .task-icon {
  background: rgba(82, 196, 26, 0.1);
  color: var(--color-success);
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-title {
  display: block;
  color: var(--on-primary-container);
  font-size: 28rpx;
  font-weight: 700;
}

.task-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--color-warm-brown-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.task-reward {
  display: block;
  margin-top: 8rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 900;
}

.task-status {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(232, 159, 113, 0.1);
  color: var(--primary);
  font-size: 18rpx;
  font-weight: 700;
}

.redeem-card {
  padding: 36rpx;
  border: 4rpx dashed rgba(232, 159, 113, 0.3);
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(99, 62, 29, 0.06);
  text-align: center;
}

.redeem-card.active {
  border-color: var(--primary);
}

.redeem-title {
  display: block;
  color: var(--on-primary-container);
  font-size: 34rpx;
  font-weight: 900;
}

.redeem-subtitle {
  display: block;
  margin-top: 14rpx;
  color: var(--color-warm-brown);
  font-size: 26rpx;
  font-weight: 800;
}

.redeem-desc,
.redeem-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.redeem-hint {
  color: var(--color-danger);
}

.redeem {
  margin-top: 28rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.36);
}

.modal-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 72vh;
  padding: 40rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  border-radius: 48rpx 48rpx 0 0;
  background: var(--surface);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.modal-title {
  color: var(--color-warm-brown);
  font-size: 34rpx;
  font-weight: 900;
}

.modal-close {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 50%;
  background: var(--surface-container);
  color: var(--color-warm-brown);
  font-size: 40rpx;
}

.history {
  height: 620rpx;
}

.history-item {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--surface-container-low);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reason {
  display: block;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 800;
}

.time {
  display: block;
  margin-top: 8rpx;
  color: var(--on-surface-variant);
  font-size: 23rpx;
}

.amount {
  color: var(--primary);
  font-size: 32rpx;
  font-weight: 900;
}

.amount.spend {
  color: var(--on-surface-variant);
}

.empty {
  padding-top: 120rpx;
  color: var(--on-surface-variant);
  text-align: center;
  font-size: 28rpx;
}

