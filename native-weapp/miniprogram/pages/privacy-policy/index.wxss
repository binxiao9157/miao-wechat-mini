.policy-page {
  min-height: 100vh;
  background: var(--background);
}

.page-header {
  min-height: 120rpx;
  padding: var(--nav-top) 40rpx 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  color: var(--color-warm-brown);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
}

.page-title {
  margin-left: 20rpx;
  color: var(--color-warm-brown);
  font-size: 34rpx;
  font-weight: 900;
}

.content {
  height: calc(100vh - 120rpx - env(safe-area-inset-top));
  padding: 32rpx 40rpx 60rpx;
  box-sizing: border-box;
}

.policy-hero {
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-icon-wrap {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: 24rpx;
  border-radius: 48rpx;
  background: rgba(232, 159, 113, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon-text {
  color: var(--primary-strong);
  font-size: 44rpx;
  font-weight: 900;
}

.hero-title {
  margin-bottom: 12rpx;
  color: var(--color-warm-brown);
  font-size: 44rpx;
  font-weight: 900;
}

.hero-subtitle {
  color: rgba(93, 64, 55, 0.3);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.sections-card {
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.5);
}

.section {
  margin-bottom: 48rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-header {
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-bar {
  width: 6rpx;
  height: 40rpx;
  border-radius: 3rpx;
  background: var(--primary);
  flex-shrink: 0;
}

.section-title {
  color: var(--color-warm-brown);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.4;
}

.section-items {
  padding-left: 22rpx;
}

.section-item {
  margin-bottom: 28rpx;
}

.section-item:last-child {
  margin-bottom: 0;
}

.item-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 800;
}

.item-detail {
  display: block;
  color: rgba(93, 64, 55, 0.7);
  font-size: 26rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.footer {
  padding-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-text {
  max-width: 560rpx;
  color: var(--text-hint);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.footer-date {
  margin-top: 32rpx;
  color: rgba(93, 64, 55, 0.25);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
