<view class="privacy-page">
  <view class="header">
    <text class="back" bindtap="goBack">‹</text>
    <text class="header-title">隐私设置</text>
  </view>

  <view class="settings">
    <view class="setting-row danger" bindtap="clearCache">
      <view class="setting-icon">×</view>
      <view class="setting-info">
        <text class="title">清除缓存</text>
        <text class="desc">当前缓存：{{cacheSize}}</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="setting-row" bindtap="goPolicy">
      <view class="setting-icon shield">✓</view>
      <view class="setting-info">
        <text class="title">隐私政策</text>
        <text class="desc">查看我们的隐私保护政策</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="info-section">
    <text>清除缓存将删除本地媒体和临时文件，不会影响您的账号信息、猫咪数据、日记文本和积分记录。</text>
  </view>

  <view wx:if="{{clearing}}" class="clearing-mask">
    <view class="clearing-card">
      <view class="spinner"></view>
      <text>正在清除...</text>
    </view>
  </view>
</view>
