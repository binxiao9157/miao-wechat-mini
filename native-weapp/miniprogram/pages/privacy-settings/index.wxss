.privacy-page {
  min-height: 100vh;
  padding: var(--nav-top, calc(env(safe-area-inset-top) + 56rpx)) 32rpx 56rpx;
  background: var(--background);
}

.header {
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  height: 72rpx;
  color: var(--color-warm-brown);
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
}

.header-title {
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 700;
}

.settings {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.setting-row {
  min-height: 132rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.setting-row:active {
  transform: scale(0.98);
}

.setting-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(255, 77, 79, 0.1);
  color: var(--color-danger);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 78rpx;
  text-align: center;
  flex-shrink: 0;
}

.setting-icon.shield {
  background: rgba(255, 157, 118, 0.1);
  color: var(--primary-strong);
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 6rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  line-height: 1.45;
}

.arrow {
  color: rgba(93, 64, 55, 0.3);
  font-size: 42rpx;
}

.info-section {
  margin-top: 32rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 157, 118, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 157, 118, 0.05);
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  line-height: 1.6;
}

.clearing-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1200;
  background: rgba(255, 249, 245, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.clearing-card {
  width: 280rpx;
  min-height: 190rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: var(--color-warm-brown);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: var(--shadow-md);
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 157, 118, 0.2);
  border-top-color: var(--primary-strong);
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.privacy-settings-page,
.privacy-page {
  min-height: 100vh;
}

.privacy-settings-scroll {
  height: 100vh;
}

.toast {
  position: fixed;
  left: 50%;
  top: calc(env(safe-area-inset-top) + 96rpx);
  z-index: 1500;
  transform: translateX(-50%);
  padding: 18rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(42, 31, 24, 0.86);
}

.toast-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
}

.settings-section,
.settings {
  display: flex;
  flex-direction: column;
}

.setting-item,
.setting-row {
  display: flex;
  align-items: center;
}

.setting-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.setting-name {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.setting-desc {
  color: var(--on-surface-variant);
  font-size: 24rpx;
}

.setting-arrow {
  color: var(--on-surface-variant);
}

.info-text {
  color: rgba(93, 64, 55, 0.45);
  font-size: 24rpx;
  line-height: 1.6;
}

.clearing-overlay,
.clearing-mask {
  position: fixed;
  inset: 0;
}

.clearing-spinner,
.spinner {
  width: 56rpx;
  height: 56rpx;
}

.clearing-text {
  color: var(--color-warm-brown);
  font-size: 26rpx;
  font-weight: 700;
}

.icon-img {
  width: 48rpx;
  height: 48rpx;
}
