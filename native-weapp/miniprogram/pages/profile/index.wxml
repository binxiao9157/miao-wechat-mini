<view class="profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="header" style="padding-top: {{headerSafeTop}};">
      <view class="header-title">
        <text class="title">Miao</text>
        <text class="subtitle">MIAO SANCTUARY</text>
      </view>
      <view class="header-actions">
        <view class="header-btn" bindtap="goFriends">
          <image class="header-icon" src="/assets/profile-icons/scan-header.png" mode="aspectFit" />
        </view>
        <view class="header-btn" bindtap="goNotificationList">
          <image class="header-icon" src="/assets/profile-icons/bell-header.png" mode="aspectFit" />
          <view wx:if="{{unreadCount > 0}}" class="unread-badge"><text class="unread-text">{{unreadCount}}</text></view>
        </view>
      </view>
    </view>

    <view class="profile-content">
      <view class="profile-header">
        <view class="avatar-wrapper">
          <image wx:if="{{avatar}}" class="avatar image-avatar" src="{{avatar}}" mode="aspectFill" />
          <view wx:else class="avatar">{{avatarLetter}}</view>
          <view class="avatar-edit-btn" bindtap="goEditProfile">
            <image class="avatar-edit-icon" src="/assets/profile-icons/camera-white.png" mode="aspectFit" />
          </view>
        </view>
        <text class="nickname">{{displayName}}</text>
        <text class="username">ID: {{username}}</text>

        <view class="stats-row">
          <view class="stat-card" bindtap="goMilestone">
            <image class="stat-icon" src="/assets/profile-icons/calendar-stat.png" mode="aspectFit"></image>
            <text class="stat-value">{{stats.days}}</text>
            <text class="stat-label">陪伴天数</text>
          </view>
          <view class="stat-card" bindtap="goDiary">
            <image class="stat-icon" src="/assets/profile-icons/image-gray.png" mode="aspectFit"></image>
            <text class="stat-value">{{stats.entries}}</text>
            <text class="stat-label">记录瞬间</text>
          </view>
        </view>

        <view class="cat-entry" bindtap="goSwitch">
          <view class="cat-entry-icon"><image src="/assets/profile-icons/heart-cat.png" mode="aspectFit"></image></view>
          <view class="cat-entry-text">
            <text class="cat-entry-label">我的伙伴</text>
            <text class="cat-entry-value">当前：{{cat.name || '未选择'}}</text>
          </view>
          <text class="cat-entry-arrow">›</text>
        </view>
      </view>

      <view class="menu-section">
        <text class="menu-title">账户设置</text>
        <view class="menu-item" bindtap="goEditProfile"><view class="menu-icon bg-blue-50"><image src="/assets/profile-icons/user-blue.png" mode="aspectFit" /></view><text class="menu-label">个人资料设置</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="goNotifications"><view class="menu-icon bg-orange-50"><image src="/assets/profile-icons/bell-primary.png" mode="aspectFit" /></view><text class="menu-label">通知设置</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="goFeedback"><view class="menu-icon bg-purple-50"><image src="/assets/profile-icons/message-gray.png" mode="aspectFit" /></view><text class="menu-label">意见反馈</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="clearCache"><view class="menu-icon bg-gray-50"><image src="/assets/profile-icons/trash2-gray.png" mode="aspectFit" /></view><text class="menu-label">清除缓存</text><text class="menu-arrow">›</text></view>
        <view class="menu-item" bindtap="logout"><view class="menu-icon bg-gray-50"><image src="/assets/profile-icons/logout-gray.png" mode="aspectFit" /></view><text class="menu-label">退出登录</text><text class="menu-arrow">›</text></view>
        <view class="menu-item danger" bindtap="deleteAccount"><view class="menu-icon bg-red-50"><image src="/assets/profile-icons/trash2-red2.png" mode="aspectFit" /></view><text class="menu-label danger-text">注销账户</text><text class="menu-arrow danger">›</text></view>
      </view>

      <view class="footer" bindtap="handleAdminTap">
        <text class="footer-text">MIAO SANCTUARY</text>
        <view class="footer-dots footer-hearts">
          <view class="footer-dot heart-primary"></view>
          <view class="footer-dot heart-secondary"></view>
          <view class="footer-dot heart-primary"></view>
        </view>
        <text class="footer-icp">浙ICP备2026026483号-1</text>
      </view>
    </view>
  </scroll-view>

  <native-tab-bar active="profile" />
</view>
