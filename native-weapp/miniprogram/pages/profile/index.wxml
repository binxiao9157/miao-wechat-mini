<view class="profile-page">
  <view class="header">
    <view class="header-title">
      <text class="title">Miao</text>
      <text class="subtitle">MIAO SANCTUARY</text>
    </view>
    <view class="header-actions">
      <button class="header-btn" bindtap="goNotificationList">
        <image class="header-icon" src="/assets/profile-icons/bell-header.png" mode="aspectFit" />
        <view wx:if="{{unreadCount > 0}}" class="unread-badge"><text class="unread-text">{{unreadCount}}</text></view>
      </button>
    </view>
  </view>

  <view class="profile-header">
    <view class="avatar-wrapper">
    <image wx:if="{{avatar}}" class="avatar image-avatar" src="{{avatar}}" mode="aspectFill" />
    <view wx:else class="avatar">{{avatarLetter}}</view>
    <view class="avatar-edit-btn" bindtap="goEditProfile">
      <image class="avatar-edit-icon" src="/assets/profile-icons/camera-white.png" mode="aspectFit" />
    </view>
    </view>
    <text class="nickname">{{displayName}}</text>
    <text class="username">{{username}}</text>
  </view>

  <view class="stats-row">
    <view class="stat-card" bindtap="goMilestone">
      <image class="stat-icon" src="/assets/profile-icons/calendar-stat.png" mode="aspectFit"></image>
      <text class="stat-value">{{stats.days}}</text>
      <text class="stat-label">陪伴天数</text>
    </view>
    <view class="stat-card" bindtap="goDiary">
      <image class="stat-icon" src="/assets/profile-icons/image-gray.png" mode="aspectFit"></image>
      <text class="stat-value">{{stats.entries}}</text>
      <text class="stat-label">记录瞬间</text>
    </view>
  </view>

  <view class="cat-entry" bindtap="goSwitch">
    <view class="cat-entry-icon"><image src="/assets/profile-icons/heart-cat.png" mode="aspectFit"></image></view>
    <view class="cat-entry-text">
      <text class="cat-entry-label">我的伙伴</text>
      <text class="cat-entry-value">当前：{{cat.name || '未选择'}}</text>
    </view>
    <text class="cat-entry-arrow">›</text>
  </view>

  <view class="quick-grid hidden-quick-grid">
    <button class="quick-item" bindtap="goHistory"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/play-white.png" mode="aspectFit" /></view><text>猫咪历史</text></button>
    <button class="quick-item" bindtap="goDiary"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/bookopen-active.png" mode="aspectFit" /></view><text>日记</text></button>
    <button class="quick-item" bindtap="goPoints"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/coins-primary.png" mode="aspectFit" /></view><text>积分</text></button>
    <button class="quick-item" bindtap="goFriends"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/userplus-gray.png" mode="aspectFit" /></view><text>好友</text></button>
  </view>

  <view class="menu-section">
    <text class="menu-title">SETTINGS</text>
    <button class="menu-item" bindtap="goEditProfile"><view class="menu-left"><view class="menu-icon blue"><image src="/assets/profile-icons/user-blue.png" mode="aspectFit" /></view><text>个人资料设置</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goSwitch"><view class="menu-left"><view class="menu-icon warm"><image src="/assets/profile-icons/heart-cat.png" mode="aspectFit" /></view><text>切换猫咪</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goMilestone"><view class="menu-left"><view class="menu-icon green"><image src="/assets/profile-icons/calendar-stat.png" mode="aspectFit" /></view><text>陪伴里程碑</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goCreate"><view class="menu-left"><view class="menu-icon warm"><image src="/assets/profile-icons/sparkles-primary.png" mode="aspectFit" /></view><text>生成新猫咪</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goLetters"><view class="menu-left"><view class="menu-icon pink"><image src="/assets/profile-icons/mail-active.png" mode="aspectFit" /></view><text>时光信</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goInvite"><view class="menu-left"><view class="menu-icon green"><image src="/assets/profile-icons/userplus-gray.png" mode="aspectFit" /></view><text>邀请好友</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item message-item" bindtap="goNotificationList">
      <view class="menu-left"><view class="menu-icon purple"><image src="/assets/profile-icons/message-purple.png" mode="aspectFit" /></view><text>{{messageLabel}}</text></view>
      <view wx:if="{{unreadCount > 0}}" class="unread-dot"></view>
      <image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" />
    </button>
    <button class="menu-item" bindtap="goNotifications"><view class="menu-left"><view class="menu-icon warm"><image src="/assets/profile-icons/bell-primary.png" mode="aspectFit" /></view><text>通知设置</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goPrivacy"><view class="menu-left"><view class="menu-icon blue"><image src="/assets/profile-icons/shieldcheck-primary.png" mode="aspectFit" /></view><text>隐私设置</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goFeedback"><view class="menu-left"><view class="menu-icon purple"><image src="/assets/profile-icons/message-gray.png" mode="aspectFit" /></view><text>意见反馈</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goPrivacyPolicy"><view class="menu-left"><view class="menu-icon blue"><image src="/assets/profile-icons/lock-gray.png" mode="aspectFit" /></view><text>隐私政策</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goTerms"><view class="menu-left"><view class="menu-icon gray"><image src="/assets/profile-icons/bookopen-inactive.png" mode="aspectFit" /></view><text>服务条款</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="clearCache"><view class="menu-left"><view class="menu-icon gray"><image src="/assets/profile-icons/trash2-gray.png" mode="aspectFit" /></view><text>清除缓存</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item danger" bindtap="deleteAccount"><view class="menu-left"><view class="menu-icon red"><image src="/assets/profile-icons/trash2-red2.png" mode="aspectFit" /></view><text>注销账户</text></view><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
  </view>

  <button class="miao-button-secondary logout" bindtap="logout">退出登录</button>

  <view class="footer" bindtap="handleAdminTap">
    <text class="footer-text">MIAO SANCTUARY</text>
    <view class="footer-dots">
      <view class="footer-dot primary"></view>
      <view class="footer-dot secondary"></view>
      <view class="footer-dot primary"></view>
    </view>
    <text class="footer-icp">浙ICP备2026026483号-1</text>
  </view>

  <native-tab-bar active="profile" />
</view>
