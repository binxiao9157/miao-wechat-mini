<view class="profile-page">
  <view class="header">
    <image class="back-icon" src="/assets/profile-icons/arrowleft-dark.png" mode="aspectFit" bindtap="goBack" />
    <text class="header-title">我的</text>
  </view>

  <view class="user-band">
    <image wx:if="{{avatar}}" class="avatar image-avatar" src="{{avatar}}" mode="aspectFill" />
    <view wx:else class="avatar">{{avatarLetter}}</view>
    <view class="user-info">
      <text class="nickname">{{displayName}}</text>
      <text class="username">{{username}}</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="stat-value">{{stats.catCount}}</text>
      <text class="stat-label">猫咪</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{stats.videoCount}}</text>
      <text class="stat-label">视频</text>
    </view>
    <view class="stat">
      <text class="stat-value">{{stats.days}}</text>
      <text class="stat-label">陪伴天数</text>
    </view>
  </view>

  <view class="quick-grid">
    <button class="quick-item" bindtap="goHistory"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/play-white.png" mode="aspectFit" /></view><text>猫咪历史</text></button>
    <button class="quick-item" bindtap="goDiary"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/bookopen-active.png" mode="aspectFit" /></view><text>日记</text></button>
    <button class="quick-item" bindtap="goPoints"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/coins-primary.png" mode="aspectFit" /></view><text>积分</text></button>
    <button class="quick-item" bindtap="goFriends"><view class="quick-icon"><image class="quick-icon-img" src="/assets/profile-icons/userplus-gray.png" mode="aspectFit" /></view><text>好友</text></button>
  </view>

  <view class="menu">
    <button class="menu-item" bindtap="goEditProfile"><text>个人资料设置</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goSwitch"><text>切换猫咪</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goMilestone"><text>陪伴里程碑</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goCreate"><text>生成新猫咪</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goLetters"><text>时光信</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goInvite"><text>邀请好友</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item message-item" bindtap="goNotificationList">
      <text>{{messageLabel}}</text>
      <view wx:if="{{unreadCount > 0}}" class="unread-dot"></view>
      <image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" />
    </button>
    <button class="menu-item" bindtap="goNotifications"><text>通知设置</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goPrivacy"><text>隐私设置</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goFeedback"><text>意见反馈</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goPrivacyPolicy"><text>隐私政策</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="goTerms"><text>服务条款</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
    <button class="menu-item" bindtap="clearCache"><text>清除缓存</text><image class="arrow-icon" src="/assets/profile-icons/chevronright-gray.png" mode="aspectFit" /></button>
  </view>

  <button class="miao-button-secondary logout" bindtap="logout">退出登录</button>

  <native-tab-bar active="profile" />
</view>
