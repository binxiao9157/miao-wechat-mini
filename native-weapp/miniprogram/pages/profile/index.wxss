.profile-page {
  min-height: 100vh;
  padding: 56rpx 36rpx calc(166rpx + env(safe-area-inset-bottom));
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.back-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 28rpx;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.user-band {
  margin-top: 42rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #E89F71;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
}

.image-avatar {
  display: block;
  background: #FEF6F0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  display: block;
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.username {
  display: block;
  margin-top: 10rpx;
  color: #8E8E8E;
  font-size: 25rpx;
}

.stats {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.stat {
  min-height: 140rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.06);
}

.stat-value {
  color: #633E1D;
  font-size: 38rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 8rpx;
  color: #8E8E8E;
  font-size: 23rpx;
}

.quick-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.quick-item {
  min-height: 128rpx;
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 28rpx rgba(99, 62, 29, 0.06);
}

.quick-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #FEF1E8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon-img {
  width: 30rpx;
  height: 30rpx;
}

.menu {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 16rpx 36rpx rgba(99, 62, 29, 0.08);
}

.menu-item {
  min-height: 104rpx;
  padding: 0 32rpx;
  border-radius: 0;
  background: transparent;
  color: #633E1D;
  font-size: 30rpx;
  line-height: 104rpx;
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-item.danger {
  color: #D64B4B;
}

.menu-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-left text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
}

.menu-icon image {
  width: 32rpx;
  height: 32rpx;
}

.menu-icon.blue {
  background: #EEF6FF;
}

.menu-icon.warm {
  background: #FEF1E8;
}

.menu-icon.green {
  background: #EEF9F1;
}

.menu-icon.pink {
  background: #FFF0F5;
}

.menu-icon.purple {
  background: #F4F0FF;
}

.menu-icon.gray {
  background: #F5F5F5;
}

.menu-icon.red {
  background: #FFF0F0;
}

.message-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.message-item text:first-child {
  flex: 1;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #D64B4B;
}

.menu-item::after {
  border: 0;
  border-bottom: 1rpx solid #F2E7DE;
}

.logout {
  margin-top: 44rpx;
}

.footer {
  margin-top: 34rpx;
  padding-bottom: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-text {
  color: #B58D73;
  font-size: 22rpx;
  font-weight: 900;
}

.footer-dots {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
}

.footer-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
}

.footer-dot.primary {
  background: #E89F71;
}

.footer-dot.secondary {
  background: #633E1D;
}

.footer-icp {
  margin-top: 10rpx;
  color: #B58D73;
  font-size: 20rpx;
}
