<view class="register-page">
  <view class="bg-decoration bg-decoration-1"></view>
  <view class="bg-decoration bg-decoration-2"></view>

  <view class="content">
    <view class="page-header">
      <text class="back" bindtap="goBack">‹</text>
      <text class="header-title">加入 Miao</text>
    </view>

    <scroll-view class="register-scroll" scroll-y>
      <view class="logo-section">
        <view class="logo-wrapper">
          <image class="logo-icon" src="/assets/logo.png" mode="aspectFit" />
        </view>
        <text class="app-name">加入 Miao</text>
      </view>

      <text class="subtitle">开启您与宠物的精致陪伴之旅，记录每一个温暖瞬间。</text>

      <view class="form-section">
        <view class="input-group">
          <text class="input-label">用户名</text>
          <view class="input-wrapper">
            <image class="input-icon" src="/assets/profile-icons/user-dark.png" mode="aspectFit" />
            <input class="miao-input with-icon" value="{{username}}" placeholder="请输入您的用户名" placeholder-style="color: #8E8E8E" bindinput="onUsernameInput" />
          </view>
        </view>

        <view class="input-group">
          <text class="input-label">设置密码</text>
          <view class="input-wrapper">
            <image class="input-icon" src="/assets/profile-icons/lock-dark.png" mode="aspectFit" />
            <input class="miao-input with-icon with-eye" value="{{password}}" placeholder="请输入您的密码" placeholder-style="color: #8E8E8E" password="{{!showPassword}}" bindinput="onPasswordInput" />
            <view class="eye-icon" bindtap="togglePassword">
              <image class="icon-img" src="{{showPassword ? '/assets/profile-icons/eyeoff-dark.png' : '/assets/profile-icons/eye-dark.png'}}" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view class="input-group">
          <text class="input-label">确认密码</text>
          <view class="input-wrapper">
            <image class="input-icon" src="/assets/profile-icons/shieldcheck-dark.png" mode="aspectFit" />
            <input class="miao-input with-icon with-eye" value="{{confirmPassword}}" placeholder="请再次输入您的密码" placeholder-style="color: #8E8E8E" password="{{!showConfirmPassword}}" bindinput="onConfirmInput" />
            <view class="eye-icon" bindtap="toggleConfirmPassword">
              <image class="icon-img" src="{{showConfirmPassword ? '/assets/profile-icons/eyeoff-dark.png' : '/assets/profile-icons/eye-dark.png'}}" mode="aspectFit" />
            </view>
          </view>
        </view>

        <view wx:if="{{error}}" class="error-box">
          <text class="error-text">{{error}}</text>
        </view>

        <view class="agreement" bindtap="toggleAgreement">
          <view class="custom-checkbox {{agreed ? 'checked' : ''}}">
            <text wx:if="{{agreed}}" class="check-mark">✓</text>
          </view>
          <text class="agreement-text">
            我已阅读并同意
            <text class="link" catchtap="goTerms">《Miao 服务条款》</text>
            和
            <text class="link" catchtap="goPrivacyPolicy">《隐私政策》</text>
          </text>
        </view>

        <button class="miao-btn-primary" loading="{{loading}}" bindtap="handleRegister">{{loading ? '注册中...' : '立即注册'}}</button>

        <view class="login-link" bindtap="goBack">
          <text class="login-link-text">已有账号？</text>
          <text class="login-link-action">登入</text>
        </view>

        <text class="bottom-agreement">
          注册即表示您同意
          <text class="link" catchtap="goTerms">《Miao 服务条款》</text>
          和
          <text class="link" catchtap="goPrivacyPolicy">《隐私政策》</text>
        </text>
      </view>
    </scroll-view>
  </view>
</view>
