.register-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 78%, var(--surface-container-low) 100%);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.bg-decoration {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  background: rgba(232, 159, 113, 0.05);
}

.bg-decoration-1 {
  width: 512rpx;
  height: 512rpx;
  top: -160rpx;
  right: -160rpx;
}

.bg-decoration-2 {
  width: 512rpx;
  height: 512rpx;
  left: -160rpx;
  bottom: -160rpx;
}

.content {
  width: 100%;
  flex: 1;
  height: 0;
  padding: calc(env(safe-area-inset-top) + 56rpx) 48rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10;
}

.page-header {
  width: 100%;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.back {
  width: 72rpx;
  color: var(--color-warm-brown);
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 900;
}

.register-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 48rpx;
}

.logo-section {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.logo-wrapper {
  width: 112rpx;
  height: 112rpx;
  transform: rotate(-12deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  width: 112rpx;
  height: 112rpx;
}

.app-name {
  margin-left: -16rpx;
  color: var(--color-warm-brown);
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1;
}

.subtitle {
  display: block;
  margin-bottom: 64rpx;
  color: var(--color-warm-brown-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.form-section {
  width: 100%;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  margin-left: 8rpx;
  margin-bottom: 12rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon {
  position: absolute;
  left: 32rpx;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translateY(-50%);
  z-index: 2;
}

.miao-input {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  border: 2rpx solid var(--outline-variant);
  border-radius: 48rpx;
  background: var(--color-warm-cream);
  box-sizing: border-box;
  color: var(--on-primary-container);
  font-size: 28rpx;
  font-weight: 700;
}

.miao-input.with-icon {
  padding-left: 78rpx;
}

.miao-input.with-icon.with-eye {
  padding-right: 82rpx;
}

.eye-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(239, 68, 68, 0.08);
}

.error-text {
  display: block;
  color: var(--color-danger);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: center;
}

.agreement {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.custom-checkbox {
  width: 36rpx;
  height: 36rpx;
  min-width: 36rpx;
  margin-top: 4rpx;
  border: 2rpx solid #d0d0d0;
  border-radius: 8rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-checkbox.checked {
  border-color: var(--primary);
  background: var(--primary);
}

.check-mark {
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.agreement-text {
  flex: 1;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.link {
  margin: 0 4rpx;
  color: var(--primary);
  font-weight: 700;
}

.miao-btn-primary {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 48rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  box-shadow: 0 16rpx 40rpx rgba(232, 159, 113, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.miao-btn-primary::after {
  border: 0;
}

.login-link {
  margin-top: 48rpx;
  text-align: center;
}

.login-link-text {
  color: var(--color-warm-brown-muted);
  font-size: 24rpx;
}

.login-link-action {
  margin-left: 8rpx;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 800;
}

.bottom-agreement {
  display: block;
  margin-top: 32rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
