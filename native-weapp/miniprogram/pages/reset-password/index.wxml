<view class="reset-password-page">
  <view wx:if="{{showSuccessToast}}" class="toast">
    <text class="toast-text">密码重置成功！</text>
  </view>

  <view class="page-header">
    <view class="back-btn" bindtap="goBack">
      <image class="back-icon" src="/assets/profile-icons/arrowleft-dark.png" mode="aspectFit" />
    </view>
    <text class="page-title">重置密码</text>
  </view>

  <scroll-view class="reset-password-scroll" scroll-y>
    <view class="form-section">
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入注册时的手机号" placeholder-style="color: #8E8E8E" data-field="phone" bindinput="onInput" />
      </view>

      <view class="form-group">
        <text class="form-label">验证码</text>
        <view class="code-row">
          <input class="code-input" type="number" maxlength="6" placeholder="请输入验证码" placeholder-style="color: #8E8E8E" data-field="code" bindinput="onInput" />
          <view class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode">
            <text class="code-btn-text">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">新密码</text>
        <view class="input-wrapper">
          <view class="input-icon">
            <image class="icon-img" src="/assets/profile-icons/lock-dark.png" mode="aspectFit" />
          </view>
          <input class="form-input-with-icon" password="{{!showPassword}}" placeholder="设置 6-20 位新密码" placeholder-style="color: #8E8E8E" data-field="password" bindinput="onInput" />
          <view class="input-toggle" bindtap="togglePassword">
            <image class="icon-img" src="{{showPassword ? '/assets/profile-icons/eyeoff-dark.png' : '/assets/profile-icons/eye-dark.png'}}" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view wx:if="{{error}}" class="error-box">
        <text class="error-text">{{error}}</text>
      </view>

      <button class="submit-btn" loading="{{saving}}" bindtap="submit">
        <text class="submit-btn-text">重置密码</text>
      </button>
    </view>
  </scroll-view>
</view>
