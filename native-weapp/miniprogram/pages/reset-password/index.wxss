.reset-password-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.page-header {
  min-height: 120rpx;
  padding: calc(env(safe-area-inset-top) + 20rpx) 48rpx 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: var(--surface-container);
  color: var(--color-warm-brown);
  font-size: 52rpx;
  line-height: 58rpx;
  text-align: center;
}

.page-title {
  margin-left: 20rpx;
  color: var(--color-warm-brown);
  font-size: 34rpx;
  font-weight: 900;
}

.reset-password-scroll {
  flex: 1;
  height: 0;
  padding: 0 48rpx 48rpx;
  box-sizing: border-box;
}

.form-section {
  padding-top: 12rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  margin-left: 8rpx;
  margin-bottom: 12rpx;
  color: rgba(93, 64, 55, 0.4);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.form-input,
.code-input,
.form-input-with-icon {
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 32rpx;
  background: #fff;
  box-sizing: border-box;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-input {
  width: 100%;
}

.code-row {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 220rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: var(--primary-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-btn.disabled {
  background: #e5e5e5;
}

.code-btn-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.code-btn.disabled .code-btn-text {
  color: #aaa;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.input-icon {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-img {
  width: 36rpx;
  height: 36rpx;
}

.form-input-with-icon {
  flex: 1;
  padding-left: 0;
  padding-right: 72rpx;
  box-shadow: none;
}

.input-toggle {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
}

button.submit-btn {
  width: 100%;
  height: 100rpx;
  margin: 24rpx 0 0;
  padding: 0;
  border-radius: 50rpx;
  background: var(--primary-strong);
  box-shadow: 0 16rpx 48rpx rgba(255, 157, 118, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

button.submit-btn::after {
  border: 0;
}

.submit-btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
}
