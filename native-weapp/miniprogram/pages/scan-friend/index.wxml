<view class="scan-friend-page">
  <view wx:if="{{showToast}}" class="toast">
    <text class="toast-text">{{showToast}}</text>
  </view>

  <view class="page-header dark">
    <view class="back-btn" bindtap="goBack">
      <image class="icon-img" src="/assets/profile-icons/arrowleft-white.png" mode="aspectFit"></image>
    </view>
    <view class="header-title">
      <text class="title-main">扫码添加好友</text>
      <text class="title-sub">SCAN FRIEND QR</text>
    </view>
    <view class="placeholder"></view>
  </view>

  <view class="scan-area">
    <view class="scan-frame">
      <view class="scan-corner top-left"></view>
      <view class="scan-corner top-right"></view>
      <view class="scan-corner bottom-left"></view>
      <view class="scan-corner bottom-right"></view>
      <view class="scan-icon-box">
        <image class="icon-img" src="/assets/profile-icons/scan-primary.png" mode="aspectFit"></image>
      </view>
    </view>
    <text class="scan-hint">将二维码放入框内扫描</text>
  </view>

  <view class="bottom-actions">
    <view class="action-item" bindtap="startScan">
      <view class="action-circle">
        <image class="icon-img" src="/assets/profile-icons/scan-primary.png" mode="aspectFit"></image>
      </view>
      <text class="action-label">再次扫码</text>
    </view>
    <view class="action-item" bindtap="openMyQr">
      <view class="action-circle">
        <text class="action-emoji">QR</text>
      </view>
      <text class="action-label">我的二维码</text>
    </view>
  </view>

  <view wx:if="{{showConfirm && friendInfo}}" class="confirm-overlay" bindtap="closeConfirm">
    <view class="confirm-dialog" catchtap="noop">
      <text class="confirm-title">添加好友</text>
      <view class="friend-info">
        <view class="friend-avatar-box">
          <image wx:if="{{friendInfo.avatar}}" class="friend-avatar-img" src="{{friendInfo.avatar}}" mode="aspectFill"></image>
          <text wx:else class="friend-avatar-text">{{friendInfo.avatarText}}</text>
        </view>
        <view class="friend-detail">
          <text class="friend-name">{{friendInfo.nickname}}</text>
          <text class="friend-cat">猫咪: {{friendInfo.catName}}</text>
        </view>
      </view>
      <view class="confirm-actions">
        <view class="confirm-btn cancel" bindtap="closeConfirm"><text class="confirm-btn-text">取消</text></view>
        <view class="confirm-btn primary" bindtap="confirmAdd"><text class="confirm-btn-text white">添加好友</text></view>
      </view>
    </view>
  </view>
</view>
