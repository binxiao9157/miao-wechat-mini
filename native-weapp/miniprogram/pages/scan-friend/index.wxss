.scan-friend-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #000;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 200rpx;
  z-index: 1500;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.8);
}

.toast-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + var(--wechat-capsule-safe-top-gap)) 32rpx 0;
}

.back-btn,
.placeholder {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: transparent;
}

.back-btn .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.header-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.title-main {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.title-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.scan-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.scan-frame {
  position: relative;
  width: 480rpx;
  height: 480rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.scan-corner {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-color: var(--primary-strong);
  border-style: solid;
  border-width: 0;
}

.top-left {
  top: 0;
  left: 0;
  border-top-width: 6rpx;
  border-left-width: 6rpx;
  border-radius: 12rpx 0 0 0;
}

.top-right {
  top: 0;
  right: 0;
  border-top-width: 6rpx;
  border-right-width: 6rpx;
  border-radius: 0 12rpx 0 0;
}

.bottom-left {
  bottom: 0;
  left: 0;
  border-bottom-width: 6rpx;
  border-left-width: 6rpx;
  border-radius: 0 0 0 12rpx;
}

.bottom-right {
  right: 0;
  bottom: 0;
  border-right-width: 6rpx;
  border-bottom-width: 6rpx;
  border-radius: 0 0 12rpx 0;
}

.scan-icon-box {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: rgba(255, 157, 118, 0.12);
}

.scan-icon-box .icon-img {
  width: 96rpx;
  height: 96rpx;
}

.scan-hint {
  color: rgba(255, 255, 255, 0.6);
  font-size: 28rpx;
  font-weight: 600;
}

.bottom-actions {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  padding: 48rpx 48rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: var(--color-overlay);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.action-circle {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
}

.action-circle .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.action-emoji {
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}

.action-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  font-weight: 600;
}

.confirm-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.48);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-sizing: border-box;
}

.backdrop-overlay {
  position: fixed;
  inset: 0;
}

.confirm-dialog {
  width: 100%;
  max-width: 600rpx;
  padding: 48rpx;
  border-radius: 40rpx;
  background: #fff;
  text-align: center;
  box-sizing: border-box;
}

.confirm-title {
  display: block;
  margin-bottom: 32rpx;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 800;
}

.friend-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--background);
}

.friend-avatar-box {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--primary-strong);
}

.friend-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
}

.friend-avatar-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
}

.friend-detail {
  flex: 1;
}

.friend-name {
  display: block;
  margin-bottom: 4rpx;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
}

.friend-cat {
  display: block;
  color: var(--text-hint);
  font-size: 22rpx;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
}

.confirm-btn.cancel {
  background: var(--surface-container);
}

.confirm-btn.primary {
  background: var(--primary-strong);
  box-shadow: 0 8rpx 24rpx rgba(255, 157, 118, 0.2);
}

.confirm-btn-text {
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 700;
}

.confirm-btn-text.white,
.white {
  color: #fff;
}

.less {
  display: none;
}
