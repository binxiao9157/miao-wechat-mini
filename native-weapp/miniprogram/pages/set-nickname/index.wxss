.nickname-page {
  min-height: 100vh;
  padding: 180rpx 48rpx 56rpx;
  background: #FFF9F5;
}

.title {
  display: block;
  color: #633E1D;
  font-size: 52rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #8E8E8E;
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  width: 100%;
  height: 96rpx;
  margin-top: 62rpx;
  padding: 0 30rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 30rpx;
}

.action {
  margin-top: 28rpx;
}
