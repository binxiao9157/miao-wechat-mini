.switch-page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  padding-top: var(--nav-top, calc(env(safe-area-inset-top) + 20rpx));
  gap: 16rpx;
}

.back {
  width: 72rpx;
  height: 72rpx;
  color: var(--color-warm-brown);
  font-size: 56rpx;
  line-height: 64rpx;
  text-align: center;
}

.header-title {
  flex: 1;
  color: var(--color-warm-brown);
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
}

.points-badge {
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 157, 118, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.points-icon {
  width: 24rpx;
  height: 24rpx;
}

.points-text {
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 900;
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  padding: 0;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-button.disabled {
  opacity: 0.5;
}

.icon-img {
  width: 32rpx;
  height: 32rpx;
}

.cat-scroll {
  flex: 1;
  height: 0;
  padding-bottom: 80rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 32rpx;
  gap: 32rpx;
}

.cat-card {
  position: relative;
  width: calc(50% - 16rpx);
  padding: 32rpx;
  border-radius: 64rpx;
  border: 4rpx solid transparent;
  background: #FFFFFF;
  box-shadow: var(--shadow-sm);
}

.cat-card.active {
  border-color: var(--primary-strong);
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.2);
}

.cat-card:active {
  transform: scale(0.95);
}

.avatar {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  background: var(--surface-container);
}

.info {
  min-width: 0;
}

.name {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  display: block;
  margin-top: 6rpx;
  color: var(--text-hint);
  font-size: 20rpx;
  font-weight: 500;
}

.active-mark {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: var(--primary-strong);
  font-size: 20rpx;
  font-weight: 800;
}

.delete-button {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 77, 79, 0.86);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 56rpx;
}

.add-card {
  width: calc(50% - 16rpx);
  min-height: 320rpx;
  margin: 0 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 40rpx;
  border: 4rpx dashed rgba(255, 157, 118, 0.3);
  background: rgba(255, 157, 118, 0.05);
  color: var(--primary-strong);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  text-align: center;
}

.add-card.disabled {
  border-color: rgba(93, 64, 55, 0.1);
  background: var(--surface-container);
  color: rgba(93, 64, 55, 0.4);
  opacity: 0.72;
}

.add-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.18;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-icon {
  width: 42rpx;
  height: 42rpx;
}

.add-info {
  min-width: 0;
}

.add-title {
  display: block;
  color: var(--color-warm-brown);
  font-size: 28rpx;
  font-weight: 800;
}

.add-cost {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cost-icon {
  width: 20rpx;
  height: 20rpx;
}

.cost-text,
.add-status {
  color: currentColor;
  font-size: 22rpx;
  font-weight: 800;
}

.add-status {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.points-hint {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 157, 118, 0.1);
  background: rgba(255, 157, 118, 0.05);
}

.points-hint-text {
  color: var(--primary-strong);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}
