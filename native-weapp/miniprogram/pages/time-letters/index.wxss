.time-letters-container {
  min-height: 100vh;
  background: var(--background);
}

.time-letters-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--background) 0%, var(--background) 84%, var(--color-warm-cream) 100%);
}

.toast-container {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 1800;
  transform: translate(-50%, -50%);
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  background: var(--primary);
  box-shadow: 0 8rpx 40rpx rgba(255, 157, 118, 0.3);
}

.toast-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  white-space: nowrap;
}

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: calc(var(--nav-top) + 96rpx) 44rpx 34rpx;
  background: transparent;
}

.header-title {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.title-main {
  color: var(--on-primary-container);
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
}

.title-sub {
  margin-top: 16rpx;
  color: var(--on-surface-variant);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-spacer,
.add-btn {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(232, 159, 113, 0.2);
}

.add-btn .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.cat-filter {
  width: 100%;
  white-space: nowrap;
  padding: 0 48rpx 48rpx;
  box-sizing: border-box;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  min-width: 108rpx;
  margin-right: 24rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--color-warm-cream);
  box-sizing: border-box;
  vertical-align: top;
}

.filter-item.active {
  background: var(--primary);
}

.filter-item.active .filter-text {
  color: #fff;
}

.filter-item.cat-item {
  min-width: 132rpx;
  justify-content: flex-start;
  padding: 0 28rpx 0 8rpx;
}

.filter-avatar {
  width: 46rpx;
  height: 46rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.filter-text {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.letters-list {
  flex: 1;
  height: 0;
  padding: 32rpx 44rpx calc(220rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.letters-container {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  width: 192rpx;
  height: 192rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  border-radius: 80rpx;
  background: var(--color-warm-cream);
}

.empty-icon .icon-img {
  width: 80rpx;
  height: 80rpx;
}

.empty-title {
  margin-bottom: 16rpx;
  color: var(--on-primary-container);
  font-size: 40rpx;
  font-weight: 900;
}

.empty-desc {
  max-width: 400rpx;
  color: var(--on-surface-variant);
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.letter-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 24rpx;
  border-radius: 40rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 12rpx 34rpx rgba(99, 62, 29, 0.08);
}

.letter-card.locked {
  border: 2rpx solid rgba(232, 159, 113, 0.2);
  background: rgba(255, 249, 245, 0.72);
  backdrop-filter: saturate(180%) blur(12px);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
}

.letter-avatar-wrap {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 32rpx;
  background: var(--color-warm-cream);
}

.letter-avatar {
  width: 100%;
  height: 100%;
}

.blur-mask {
  position: absolute;
  inset: 0;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.lock-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.15);
}

.lock-overlay .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.unlock-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 50%;
  background: var(--color-success);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.unlock-badge .icon-img {
  width: 20rpx;
  height: 20rpx;
}

.letter-content {
  flex: 1;
  min-width: 0;
  height: 192rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
  box-sizing: border-box;
}

.letter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.letter-title {
  flex: 1;
  overflow: hidden;
  color: var(--on-primary-container);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
}

.delete-btn .icon-img {
  width: 30rpx;
  height: 30rpx;
}

.letter-preview {
  min-height: 48rpx;
}

.preview-text,
.countdown-text {
  color: var(--on-surface-variant);
  font-size: 24rpx;
  line-height: 1.5;
}

.preview-text {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.countdown-highlight {
  color: var(--primary);
  font-weight: 900;
}

.letter-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.target-cat,
.letter-date {
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.target-cat {
  max-width: 210rpx;
  overflow: hidden;
  color: var(--on-surface-variant);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.letter-date {
  color: #c8bdb6;
}

.letter-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0.22;
}

.letter-arrow .icon-img {
  width: 32rpx;
  height: 32rpx;
}

.write-page {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  flex-direction: column;
  background: var(--surface-container);
}

.write-scroll {
  flex: 1;
  height: 0;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  box-sizing: border-box;
}

.write-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
  padding-top: calc(var(--nav-top) + 96rpx);
}

.back-btn,
.placeholder {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--surface-container-low);
}

.back-btn .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.write-title,
.detail-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.write-title .title-main,
.detail-title .title-main {
  font-size: 40rpx;
}

.write-title .title-sub,
.detail-title .title-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--on-surface-variant);
  font-size: 24rpx;
  font-weight: 900;
}

.cat-selector {
  white-space: nowrap;
  padding: 16rpx 0;
}

.cat-option {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}

.cat-avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  overflow: hidden;
  border: 8rpx solid transparent;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.cat-avatar-wrap.active {
  border-color: var(--primary-strong);
  box-shadow: 0 8rpx 24rpx rgba(255, 157, 118, 0.3);
}

.cat-avatar {
  width: 100%;
  height: 100%;
}

.selected-badge {
  position: absolute;
  right: -8rpx;
  bottom: 40rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  border-radius: 50%;
  background: var(--primary-strong);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.selected-badge .icon-img {
  width: 20rpx;
  height: 20rpx;
}

.cat-name {
  margin-top: 12rpx;
  color: var(--on-surface-variant);
  font-size: 20rpx;
  font-weight: 900;
}

.cat-name.active {
  color: var(--primary-strong);
}

.title-input {
  width: 100%;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: var(--surface-container-low);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 80rpx;
  box-sizing: border-box;
}

.content-textarea {
  width: 100%;
  height: 400rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: var(--surface-container-low);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.input-placeholder,
.textarea-placeholder {
  color: rgba(109, 94, 84, 0.3);
  font-weight: 400;
}

.days-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.days-header .section-label {
  margin-bottom: 0;
}

.days-display {
  color: var(--primary-strong);
  font-size: 28rpx;
  font-weight: 900;
}

.days-grid {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0;
}

.day-option {
  flex: 1;
  min-width: 0;
  padding: 32rpx 0;
  border-radius: 32rpx;
  background: var(--surface-container-low);
  text-align: center;
}

.day-option.selected {
  background: var(--primary-strong);
  box-shadow: 0 8rpx 24rpx rgba(255, 157, 118, 0.3);
}

.day-text {
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 900;
}

.day-option.selected .day-text {
  color: #fff;
}

.save-btn {
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 48rpx 0 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--primary-strong);
  box-shadow: 0 8rpx 32rpx rgba(255, 157, 118, 0.3);
}

.save-btn::after {
  border: 0;
}

.save-btn.disabled {
  opacity: 0.35;
}

.save-btn .icon-img {
  width: 40rpx;
  height: 40rpx;
}

.save-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
}

.detail-page {
  position: fixed;
  inset: 0;
  z-index: 1200;
  overflow: hidden;
  background: #2d211d;
}

.detail-bg {
  position: absolute;
  inset: 0;
}

.detail-bg-image {
  width: 100%;
  height: 48vh;
}

.detail-bg-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(43, 28, 20, 0.22) 0%, rgba(43, 28, 20, 0.68) 42%, var(--background) 78%);
}

.detail-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(var(--nav-top) + 96rpx) 32rpx 0;
}

.detail-back {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.18);
}

.detail-back .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.detail-title .title-main,
.detail-title .title-sub {
  color: #fff;
}

.detail-guide {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 64rpx;
}

.guide-label {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  font-weight: 900;
}

.guide-name {
  margin-top: 12rpx;
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
}

.detail-card {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  z-index: 3;
  height: 58vh;
  border-radius: 48rpx 48rpx 0 0;
  background: var(--background);
  box-shadow: 0 -16rpx 54rpx rgba(54, 34, 22, 0.12);
}

.card-content {
  position: relative;
  min-height: 100%;
  padding: 48rpx 40rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-sizing: border-box;
}

.deco-circle {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(232, 159, 113, 0.08);
}

.deco-circle.top {
  top: -80rpx;
  right: -52rpx;
}

.deco-circle.bottom {
  bottom: 24rpx;
  left: -88rpx;
}

.letter-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.letter-meta .icon-img {
  width: 36rpx;
  height: 36rpx;
}

.meta-text {
  color: var(--on-surface-variant);
  font-size: 24rpx;
  font-weight: 900;
}

.detail-letter-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 40rpx;
  color: var(--on-primary-container);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.25;
}

.detail-letter-content {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 36rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.detail-footer {
  position: relative;
  z-index: 1;
  margin-top: 72rpx;
  text-align: center;
}

.footer-line,
.brand-line {
  width: 88rpx;
  height: 4rpx;
  margin: 0 auto 24rpx;
  border-radius: 99rpx;
  background: var(--primary);
  opacity: 0.38;
}

.footer-desc {
  color: var(--on-surface-variant);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.8;
}

.footer-brand {
  margin-top: 44rpx;
}

.brand-text {
  color: #c8bdb6;
  font-size: 20rpx;
  font-weight: 900;
}

.confirm-overlay {
  position: fixed;
  inset: 0;
  z-index: 1600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
  background: rgba(40, 28, 20, 0.36);
  box-sizing: border-box;
}

.confirm-card {
  width: 100%;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 40rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 22rpx 70rpx rgba(75, 46, 25, 0.18);
  box-sizing: border-box;
}

.confirm-icon-box {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: #fff1ec;
}

.confirm-icon-box .icon-img {
  width: 48rpx;
  height: 48rpx;
}

.confirm-title {
  display: block;
  color: var(--on-primary-container);
  font-size: 34rpx;
  font-weight: 900;
}

.confirm-desc {
  display: block;
  margin-top: 18rpx;
  color: var(--on-surface-variant);
  font-size: 26rpx;
  line-height: 1.7;
}

.highlight {
  color: #ff4444;
  font-weight: 900;
}

.confirm-modal-desc {
  color: var(--on-surface-variant);
  font-size: 26rpx;
  line-height: 1.7;
}

.rotate-45 {
  transform: rotate(45deg);
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.confirm-btn.secondary {
  color: var(--on-surface-variant);
  background: var(--surface-container-low);
}

.confirm-btn.danger {
  color: #fff;
  background: #ef6f5e;
}
