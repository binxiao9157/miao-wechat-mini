<view class="upload-material-page">
  <view class="back-btn" bindtap="goBack">
    <image class="icon-img" src="/assets/profile-icons/arrowleft-dark.png" mode="aspectFit" />
  </view>

  <scroll-view class="upload-material-scroll" scroll-y>
    <view class="content">
      <view class="title-section">
        <text class="main-title">AI 形象生成</text>
        <text class="sub-title">AI IMAGE GENERATION</text>
        <text class="desc">上传一张您家猫咪的照片，AI 将为您生成专属的数字形象。</text>
        <text wx:if="{{isRedemption}}" class="redemption">{{redemptionText}}</text>
      </view>

      <view class="image-area">
        <view wx:if="{{imagePath}}" class="image-preview">
          <image class="preview-img" src="{{imagePath}}" mode="aspectFill" />
          <view class="remove-btn" catchtap="removePhoto">
            <image class="icon-img remove-icon" src="/assets/profile-icons/x-dark.png" mode="aspectFit" />
          </view>
        </view>
        <view wx:else class="upload-placeholder" bindtap="choosePhoto">
          <view class="upload-icon-box">
            <image class="icon-img upload-icon" src="/assets/profile-icons/upload-primary.png" mode="aspectFit" />
          </view>
          <text class="upload-text">点击上传照片</text>
          <text class="upload-hint">JPG, PNG 支持</text>
        </view>
      </view>

      <view class="input-section">
        <input class="nickname-input" value="{{name}}" placeholder="给猫咪起个好听的名字" placeholder-class="nickname-placeholder" bindinput="onNameInput" />
      </view>
      <text wx:if="{{error}}" class="error">{{error}}</text>

      <view class="btn-section">
        <button wx:if="{{!firstFrameUrl}}" class="generate-btn {{imagePath && name ? 'active' : 'disabled'}}" loading="{{generating}}" bindtap="handleGenerateAnchor">
          <image class="icon-img btn-icon" src="/assets/profile-icons/sparkles-white.png" mode="aspectFit" />
          <text class="btn-label">{{generating ? '绘制专属形象中...' : '开始生成数字形象'}}</text>
        </button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{firstFrameUrl}}" class="confirm-overlay">
    <view class="confirm-dialog">
      <view class="confirm-header">
        <text class="confirm-title">专属形象初稿</text>
        <text class="confirm-desc">AI 已捕捉到了猫咪的灵魂特征</text>
      </view>
      <view class="confirm-image-box">
        <image class="confirm-image" src="{{firstFrameUrl}}" mode="aspectFill" show-menu-by-longpress />
      </view>
      <view class="confirm-actions">
        <button class="confirm-btn primary" loading="{{generating}}" bindtap="confirmAndGenerate">
          <image class="icon-img confirm-btn-icon" src="/assets/profile-icons/sparkles-primary.png" mode="aspectFit" />
          <text class="confirm-btn-text primary">确认并注入生命力</text>
        </button>
        <view class="confirm-btn-row">
          <button class="confirm-btn secondary" loading="{{generating}}" bindtap="regenerateAnchor">
            <text class="confirm-btn-text secondary">重新生成</text>
          </button>
          <button class="confirm-btn secondary" loading="{{savingImage}}" bindtap="saveFirstFrame">
            <text class="confirm-btn-text secondary">保存图片</text>
          </button>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{generating && !firstFrameUrl}}" class="loading-overlay">
    <view class="loading-spinner">
      <view class="spinner-ring"></view>
      <view class="spinner-icon">
        <image class="icon-img loading-icon" src="/assets/profile-icons/sparkles-primary.png" mode="aspectFit" />
      </view>
    </view>
    <text class="loading-title">正在绘制专属形象...</text>
    <text class="loading-subtitle">STAGE 1: IMAGE CAPTURE</text>
  </view>
</view>
