.upload-page {
  min-height: 100vh;
  padding: 56rpx 48rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.hero {
  margin-top: 48rpx;
}

.title {
  color: #633E1D;
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #8E8E8E;
  font-size: 28rpx;
  line-height: 1.6;
}

.redemption {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #FEF6F0;
  color: #E89F71;
  font-size: 24rpx;
  font-weight: 900;
}

.picker {
  margin-top: 48rpx;
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(99, 62, 29, 0.08);
}

.preview {
  width: 100%;
  height: 100%;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-title {
  color: #633E1D;
  font-size: 32rpx;
  font-weight: 900;
}

.placeholder-subtitle {
  margin-top: 12rpx;
  color: #8E8E8E;
  font-size: 26rpx;
}

.input {
  width: 100%;
  min-height: 96rpx;
  margin-top: 32rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 30rpx;
}

.error {
  display: block;
  margin-top: 24rpx;
  color: #D64B4B;
  font-size: 26rpx;
}

.action {
  margin-top: 36rpx;
}
