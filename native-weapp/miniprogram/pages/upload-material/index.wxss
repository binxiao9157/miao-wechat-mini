.upload-page {
  min-height: 100vh;
  padding: 56rpx 48rpx;
  background: #FFF9F5;
}

.header {
  height: 72rpx;
  display: flex;
  align-items: center;
}

.back {
  width: 72rpx;
  color: #633E1D;
  font-size: 64rpx;
  line-height: 1;
}

.header-title {
  color: #633E1D;
  font-size: 34rpx;
  font-weight: 900;
}

.hero {
  margin-top: 48rpx;
}

.title {
  color: #633E1D;
  font-size: 44rpx;
  font-weight: 900;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #8E8E8E;
  font-size: 28rpx;
  line-height: 1.6;
}

.redemption {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #FEF6F0;
  color: #E89F71;
  font-size: 24rpx;
  font-weight: 900;
}

.picker {
  position: relative;
  margin-top: 48rpx;
  width: 100%;
  height: 560rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 44rpx rgba(99, 62, 29, 0.08);
}

.remove-button {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  width: 28rpx;
  height: 28rpx;
}

.preview {
  width: 100%;
  height: 100%;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 24rpx;
}

.placeholder-title {
  color: #633E1D;
  font-size: 32rpx;
  font-weight: 900;
}

.placeholder-subtitle {
  margin-top: 12rpx;
  color: #8E8E8E;
  font-size: 26rpx;
}

.input {
  width: 100%;
  min-height: 96rpx;
  margin-top: 32rpx;
  padding: 0 32rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  color: #633E1D;
  font-size: 30rpx;
}

.error {
  display: block;
  margin-top: 24rpx;
  color: #D64B4B;
  font-size: 26rpx;
}

.action {
  margin-top: 36rpx;
}

.result-card {
  margin-top: 36rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 44rpx rgba(99, 62, 29, 0.08);
}

.result-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.result-head-icon {
  width: 34rpx;
  height: 34rpx;
}

.result-title {
  color: #633E1D;
  font-size: 30rpx;
  font-weight: 900;
}

.result-image {
  width: 100%;
  height: 520rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #FEF6F0;
}

.result-desc {
  display: block;
  margin-top: 18rpx;
  color: #8E8E8E;
  font-size: 25rpx;
  line-height: 1.55;
}

.result-actions {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.result-btn {
  min-height: 82rpx;
  padding: 0;
  border-radius: 42rpx;
  font-size: 25rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.result-btn.secondary {
  background: #FEF6F0;
  color: #633E1D;
}

.result-btn-icon {
  width: 30rpx;
  height: 30rpx;
}

.confirm-action {
  margin-top: 24rpx;
}
